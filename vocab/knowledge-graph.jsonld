   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/PolicyClause/uk-dqap-if-3",
   "@type": [
    "dqc:PolicyClause"
   ],
   "label": "IF-3: Bands below target set a band score; priority = combined x band",
   "definition": "Area: Scoring. Strength: method. Toolkit: framework.py; parity-checked browser engine",
   "dqc:clauseOf": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dqap"
    }
   ]
  },
