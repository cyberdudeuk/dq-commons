{
 "@context": {
  "dqc": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#",
  "skos": "http://www.w3.org/2004/02/skos/core#",
  "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
  "owl": "http://www.w3.org/2002/07/owl#",
  "label": "rdfs:label",
  "definition": "skos:definition",
  "altLabel": "skos:altLabel",
  "seeAlso": {
   "@id": "rdfs:seeAlso",
   "@type": "@id"
  }
 },
 "@graph": [
  {
   "@id": "dqc:Dataset",
   "@type": "owl:Class",
   "label": "Dataset or data asset",
   "definition": "A collection of data managed as one thing, such as a critical data asset."
  },
  {
   "@id": "dqc:Rule",
   "@type": "owl:Class",
   "label": "Data quality rule",
   "definition": "A testable statement of what good data looks like, with a target."
  },
  {
   "@id": "dqc:Check",
   "@type": "owl:Class",
   "label": "Check type",
   "definition": "A kind of test the toolkit can run, such as not_null or freshness."
  },
  {
   "@id": "dqc:Dimension",
   "@type": "owl:Class",
   "label": "Quality dimension",
   "definition": "An aspect of quality, such as completeness or timeliness."
  },
  {
   "@id": "dqc:IssueType",
   "@type": "owl:Class",
   "label": "Issue type",
   "definition": "A category of data quality problem from the cross-government vocabulary."
  },
  {
   "@id": "dqc:Measurement",
   "@type": "owl:Class",
   "label": "Quality measurement",
   "definition": "The result of running a rule on a dataset on a date."
  },
  {
   "@id": "dqc:Issue",
   "@type": "owl:Class",
   "label": "Data quality issue",
   "definition": "A rule below target, with a priority and a time to fix."
  },
  {
   "@id": "dqc:Framework",
   "@type": "owl:Class",
   "label": "Framework, standard or policy",
   "definition": "A published source of data quality requirements."
  },
  {
   "@id": "dqc:Pack",
   "@type": "owl:Class",
   "label": "Framework pack",
   "definition": "Requirements from a framework, tested automatically against results."
  },
  {
   "@id": "dqc:Requirement",
   "@type": "owl:Class",
   "label": "Requirement",
   "definition": "One thing a pack or policy asks for, with the evidence that shows it."
  },
  {
   "@id": "dqc:PolicyClause",
   "@type": "owl:Class",
   "label": "Policy clause",
   "definition": "One clause of a policy, broken down line by line."
  },
  {
   "@id": "dqc:MetadataConcept",
   "@type": "owl:Class",
   "label": "Metadata concept",
   "definition": "A cataloguing concept mapped across standards in the Metadata Rosetta."
  },
  {
   "@id": "dqc:MetadataStandard",
   "@type": "owl:Class",
   "label": "Metadata standard",
   "definition": "A standard for describing data, such as DCAT or schema.org."
  },
  {
   "@id": "dqc:Role",
   "@type": "owl:Class",
   "label": "Role",
   "definition": "A job role with responsibilities for data quality."
  },
  {
   "@id": "dqc:Skill",
   "@type": "owl:Class",
   "label": "Skill",
   "definition": "A data quality skill, aligned with the DDaT capability framework."
  },
  {
   "@id": "dqc:Module",
   "@type": "owl:Class",
   "label": "Learning module",
   "definition": "A Commons learning module."
  },
  {
   "@id": "dqc:Course",
   "@type": "owl:Class",
   "label": "Course or qualification",
   "definition": "External or Commons training."
  },
  {
   "@id": "dqc:Event",
   "@type": "owl:Class",
   "label": "Event",
   "definition": "A conference, workshop, course run or forum about data quality."
  },
  {
   "@id": "dqc:Jurisdiction",
   "@type": "owl:Class",
   "label": "Jurisdiction",
   "definition": "A nation, Crown Dependency, Overseas Territory or international level."
  },
  {
   "@id": "dqc:Organisation",
   "@type": "owl:Class",
   "label": "Organisation or network",
   "definition": "A body, network or partner."
  },
  {
   "@id": "dqc:Term",
   "@type": "owl:Class",
   "label": "Glossary term",
   "definition": "A term defined in the Commons glossary."
  },
  {
   "@id": "dqc:Stage",
   "@type": "owl:Class",
   "label": "Lineage stage",
   "definition": "A step data passes through, from source to report."
  },
  {
   "@id": "dqc:Capability",
   "@type": "owl:Class",
   "label": "Capability",
   "definition": "A part of end-to-end data quality management, from the Commons capability model."
  },
  {
   "@id": "dqc:Workflow",
   "@type": "owl:Class",
   "label": "Workflow",
   "definition": "A process that carries out a capability, with steps, roles and records (BPMN in models/out/bpmn)."
  },
  {
   "@id": "dqc:RecordType",
   "@type": "owl:Class",
   "label": "Record type",
   "definition": "A kind of record the data quality capability keeps, from the Commons information model."
  },
  {
   "@id": "dqc:Thing",
   "@type": "owl:Class",
   "label": "Any thing",
   "definition": "Any node in the graph (used as a range when a relationship can point to several classes)."
  },
  {
   "@id": "dqc:guidedBy",
   "@type": "owl:ObjectProperty",
   "label": "guided by",
   "definition": "The policy or guidance a capability or record type puts into practice.",
   "rdfs:domain": {
    "@id": "dqc:Thing"
   },
   "rdfs:range": {
    "@id": "dqc:Framework"
   }
  },
  {
   "@id": "dqc:keepsRecord",
   "@type": "owl:ObjectProperty",
   "label": "keeps record",
   "definition": "A record type a capability manages.",
   "rdfs:domain": {
    "@id": "dqc:Capability"
   },
   "rdfs:range": {
    "@id": "dqc:RecordType"
   }
  },
  {
   "@id": "dqc:realisedBy",
   "@type": "owl:ObjectProperty",
   "label": "realised by",
   "definition": "A workflow that carries out a capability.",
   "rdfs:domain": {
    "@id": "dqc:Capability"
   },
   "rdfs:range": {
    "@id": "dqc:Workflow"
   }
  },
  {
   "@id": "dqc:performedBy",
   "@type": "owl:ObjectProperty",
   "label": "performed by",
   "definition": "A role with steps in a workflow.",
   "rdfs:domain": {
    "@id": "dqc:Workflow"
   },
   "rdfs:range": {
    "@id": "dqc:Role"
   }
  },
  {
   "@id": "dqc:createsRecord",
   "@type": "owl:ObjectProperty",
   "label": "creates record",
   "definition": "A record type a workflow creates or updates.",
   "rdfs:domain": {
    "@id": "dqc:Workflow"
   },
   "rdfs:range": {
    "@id": "dqc:RecordType"
   }
  },
  {
   "@id": "dqc:linksTo",
   "@type": "owl:ObjectProperty",
   "label": "links to",
   "definition": "One record type refers to another.",
   "rdfs:domain": {
    "@id": "dqc:RecordType"
   },
   "rdfs:range": {
    "@id": "dqc:RecordType"
   }
  },
  {
   "@id": "dqc:measures",
   "@type": "owl:ObjectProperty",
   "label": "measures",
   "definition": "The dimension a rule measures.",
   "rdfs:domain": {
    "@id": "dqc:Rule"
   },
   "rdfs:range": {
    "@id": "dqc:Dimension"
   }
  },
  {
   "@id": "dqc:uses",
   "@type": "owl:ObjectProperty",
   "label": "uses check",
   "definition": "The check type a rule runs.",
   "rdfs:domain": {
    "@id": "dqc:Rule"
   },
   "rdfs:range": {
    "@id": "dqc:Check"
   }
  },
  {
   "@id": "dqc:checksDimension",
   "@type": "owl:ObjectProperty",
   "label": "checks dimension",
   "definition": "The dimension a check type usually measures.",
   "rdfs:domain": {
    "@id": "dqc:Check"
   },
   "rdfs:range": {
    "@id": "dqc:Dimension"
   }
  },
  {
   "@id": "dqc:classifiedAs",
   "@type": "owl:ObjectProperty",
   "label": "classified as",
   "definition": "The issue type of an issue.",
   "rdfs:domain": {
    "@id": "dqc:Issue"
   },
   "rdfs:range": {
    "@id": "dqc:IssueType"
   }
  },
  {
   "@id": "dqc:inDimension",
   "@type": "owl:ObjectProperty",
   "label": "in dimension",
   "definition": "The dimension an issue type belongs to.",
   "rdfs:domain": {
    "@id": "dqc:IssueType"
   },
   "rdfs:range": {
    "@id": "dqc:Dimension"
   }
  },
  {
   "@id": "dqc:mapsTo",
   "@type": "owl:ObjectProperty",
   "label": "maps to",
   "definition": "A framework dimension maps to a Commons dimension.",
   "rdfs:domain": {
    "@id": "dqc:Framework"
   },
   "rdfs:range": {
    "@id": "dqc:Dimension"
   }
  },
  {
   "@id": "dqc:implements",
   "@type": "owl:ObjectProperty",
   "label": "implements",
   "definition": "The framework a pack puts into practice.",
   "rdfs:domain": {
    "@id": "dqc:Pack"
   },
   "rdfs:range": {
    "@id": "dqc:Framework"
   }
  },
  {
   "@id": "dqc:requires",
   "@type": "owl:ObjectProperty",
   "label": "requires",
   "definition": "A requirement in a pack.",
   "rdfs:domain": {
    "@id": "dqc:Pack"
   },
   "rdfs:range": {
    "@id": "dqc:Requirement"
   }
  },
  {
   "@id": "dqc:evidencedBy",
   "@type": "owl:ObjectProperty",
   "label": "evidenced by",
   "definition": "Evidence that shows a requirement is met (a check or a dimension).",
   "rdfs:domain": {
    "@id": "dqc:Requirement"
   },
   "rdfs:range": {
    "@id": "dqc:Check"
   }
  },
  {
   "@id": "dqc:clauseOf",
   "@type": "owl:ObjectProperty",
   "label": "clause of",
   "definition": "The policy a clause belongs to.",
   "rdfs:domain": {
    "@id": "dqc:PolicyClause"
   },
   "rdfs:range": {
    "@id": "dqc:Framework"
   }
  },
  {
   "@id": "dqc:supportedBy",
   "@type": "owl:ObjectProperty",
   "label": "supported by",
   "definition": "How the toolkit supports a clause.",
   "rdfs:domain": {
    "@id": "dqc:PolicyClause"
   },
   "rdfs:range": {
    "@id": "dqc:Check"
   }
  },
  {
   "@id": "dqc:appliesIn",
   "@type": "owl:ObjectProperty",
   "label": "applies in",
   "definition": "Where a framework applies.",
   "rdfs:domain": {
    "@id": "dqc:Framework"
   },
   "rdfs:range": {
    "@id": "dqc:Jurisdiction"
   }
  },
  {
   "@id": "dqc:expressedIn",
   "@type": "owl:ObjectProperty",
   "label": "expressed in",
   "definition": "A standard's term for a metadata concept.",
   "rdfs:domain": {
    "@id": "dqc:MetadataConcept"
   },
   "rdfs:range": {
    "@id": "dqc:MetadataStandard"
   }
  },
  {
   "@id": "dqc:needsSkill",
   "@type": "owl:ObjectProperty",
   "label": "needs skill",
   "definition": "A skill a role needs.",
   "rdfs:domain": {
    "@id": "dqc:Role"
   },
   "rdfs:range": {
    "@id": "dqc:Skill"
   }
  },
  {
   "@id": "dqc:teaches",
   "@type": "owl:ObjectProperty",
   "label": "teaches",
   "definition": "A skill a course or module teaches.",
   "rdfs:domain": {
    "@id": "dqc:Course"
   },
   "rdfs:range": {
    "@id": "dqc:Skill"
   }
  },
  {
   "@id": "dqc:forRole",
   "@type": "owl:ObjectProperty",
   "label": "for role",
   "definition": "A module on a role's pathway.",
   "rdfs:domain": {
    "@id": "dqc:Module"
   },
   "rdfs:range": {
    "@id": "dqc:Role"
   }
  },
  {
   "@id": "dqc:about",
   "@type": "owl:ObjectProperty",
   "label": "about",
   "definition": "A glossary term this node is about (for example an event topic, or an open standard about metadata).",
   "rdfs:domain": {
    "@id": "dqc:Thing"
   },
   "rdfs:range": {
    "@id": "dqc:Term"
   }
  },
  {
   "@id": "dqc:partOf",
   "@type": "owl:ObjectProperty",
   "label": "part of",
   "definition": "A place within a wider grouping.",
   "rdfs:domain": {
    "@id": "dqc:Jurisdiction"
   },
   "rdfs:range": {
    "@id": "dqc:Jurisdiction"
   }
  },
  {
   "@id": "dqc:flowsTo",
   "@type": "owl:ObjectProperty",
   "label": "flows to",
   "definition": "Data lineage: the next stage.",
   "rdfs:domain": {
    "@id": "dqc:Stage"
   },
   "rdfs:range": {
    "@id": "dqc:Stage"
   }
  },
  {
   "@id": "dqc:broader",
   "@type": "owl:ObjectProperty",
   "label": "broader",
   "definition": "A broader term (SKOS broader).",
   "rdfs:domain": {
    "@id": "dqc:Term"
   },
   "rdfs:range": {
    "@id": "dqc:Term"
   }
  },
  {
   "@id": "dqc:related",
   "@type": "owl:ObjectProperty",
   "label": "related",
   "definition": "A related term (SKOS related).",
   "rdfs:domain": {
    "@id": "dqc:Term"
   },
   "rdfs:range": {
    "@id": "dqc:Term"
   }
  },
  {
   "@id": "dqc:definedBy",
   "@type": "owl:ObjectProperty",
   "label": "defined by",
   "definition": "The source of a term's definition.",
   "rdfs:domain": {
    "@id": "dqc:Term"
   },
   "rdfs:range": {
    "@id": "dqc:Framework"
   }
  },
  {
   "@id": "dqc:defaultIssue",
   "@type": "owl:ObjectProperty",
   "label": "default issue",
   "definition": "The issue type a failing check raises by default.",
   "rdfs:domain": {
    "@id": "dqc:Check"
   },
   "rdfs:range": {
    "@id": "dqc:IssueType"
   }
  },
  {
   "@id": "dqc:heldIn",
   "@type": "owl:ObjectProperty",
   "label": "held in",
   "definition": "Where an event takes place.",
   "rdfs:domain": {
    "@id": "dqc:Event"
   },
   "rdfs:range": {
    "@id": "dqc:Jurisdiction"
   }
  },
  {
   "@id": "dqc:sameAs",
   "@type": "owl:ObjectProperty",
   "label": "same as",
   "definition": "The glossary term names the same thing as another node (a dimension, role or standard).",
   "rdfs:domain": {
    "@id": "dqc:Term"
   },
   "rdfs:range": {
    "@id": "dqc:Thing"
   }
  },
  {
   "@id": "dqc:involves",
   "@type": "owl:ObjectProperty",
   "label": "involves",
   "definition": "A concept, standard or tool used at a lineage stage.",
   "rdfs:domain": {
    "@id": "dqc:Stage"
   },
   "rdfs:range": {
    "@id": "dqc:Thing"
   }
  },
  {
   "@id": "dqc:inScope",
   "@type": "owl:ObjectProperty",
   "label": "in scope of",
   "definition": "A place or level the Commons serves.",
   "rdfs:domain": {
    "@id": "dqc:Jurisdiction"
   },
   "rdfs:range": {
    "@id": "dqc:Jurisdiction"
   }
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/completeness",
   "@type": [
    "dqc:Dimension",
    "skos:Concept"
   ],
   "label": "Completeness",
   "definition": "The proportion of stored data against the potential of being 100% complete.",
   "owl:sameAs": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#completeness"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/uniqueness",
   "@type": [
    "dqc:Dimension",
    "skos:Concept"
   ],
   "label": "Uniqueness",
   "definition": "Nothing will be recorded more than once based upon how that thing is identified.",
   "owl:sameAs": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#uniqueness"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/consistency",
   "@type": [
    "dqc:Dimension",
    "skos:Concept"
   ],
   "label": "Consistency",
   "definition": "The absence of difference when comparing two or more representations of a thing against a definition.",
   "owl:sameAs": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#consistency"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/timeliness",
   "@type": [
    "dqc:Dimension",
    "skos:Concept"
   ],
   "label": "Timeliness",
   "definition": "The degree to which data represent reality from the required point in time.",
   "owl:sameAs": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#timeliness"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/validity",
   "@type": [
    "dqc:Dimension",
    "skos:Concept"
   ],
   "label": "Validity",
   "definition": "Data are valid if they conform to the syntax (format, type, range) of their definition.",
   "owl:sameAs": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#validity"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy",
   "@type": [
    "dqc:Dimension",
    "skos:Concept"
   ],
   "label": "Accuracy",
   "definition": "The degree to which data correctly describe the real-world object or event being described.",
   "owl:sameAs": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#accuracy"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/representativeness",
   "@type": [
    "dqc:Dimension",
    "skos:Concept"
   ],
   "label": "Representativeness",
   "definition": "The degree to which data cover, and are equally good for, every group of people they describe. Extension proposed by this project; not one of the six DAMA UK dimensions.",
   "owl:sameAs": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#representativeness"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/metadata",
   "@type": [
    "dqc:Dimension",
    "skos:Concept"
   ],
   "label": "Metadata quality",
   "definition": "The degree to which an asset is described well enough to find, understand, trust and reuse it. Covers GOV.UK critical data asset metadata and DAM policy duties.",
   "owl:sameAs": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#metadata"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/relevance",
   "@type": [
    "dqc:Dimension",
    "skos:Concept"
   ],
   "label": "Relevance",
   "definition": "Whether the data meets the needs of users. ESS 'plus' dimension, assessed mainly by qualitative evidence.",
   "owl:sameAs": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#relevance"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/coherence-comparability",
   "@type": [
    "dqc:Dimension",
    "skos:Concept"
   ],
   "label": "Coherence and comparability",
   "definition": "Whether the data is coherent with other sources and comparable over time and between areas. ESS 'plus' dimension.",
   "owl:sameAs": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#coherence-comparability"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accessibility-clarity",
   "@type": [
    "dqc:Dimension",
    "skos:Concept"
   ],
   "label": "Accessibility and clarity",
   "definition": "Whether the data is clear, released in a convenient form, and has supporting metadata and guidance. ESS 'plus' dimension.",
   "owl:sameAs": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#accessibility-clarity"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/IssueType/missing-value",
   "@type": [
    "dqc:IssueType",
    "skos:Concept"
   ],
   "label": "Missing value",
   "definition": "A required field is blank for a record.",
   "owl:sameAs": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#issue/missing-value"
    }
   ],
   "dqc:inDimension": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/completeness"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/IssueType/missing-field",
   "@type": [
    "dqc:IssueType",
    "skos:Concept"
   ],
   "label": "Missing field",
   "definition": "A required field is absent from the file.",
   "owl:sameAs": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#issue/missing-field"
    }
   ],
   "dqc:inDimension": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/completeness"
    }
   ]
