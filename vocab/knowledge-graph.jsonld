  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/PolicyClause/uk-dam-policy-dam-1",
   "@type": [
    "dqc:PolicyClause"
   ],
   "label": "DAM-1: Identify, record and centrally report shared critical data assets",
   "definition": "Area: Scope. Strength: must. Toolkit: Portfolio file lists assets; CDA return rows (cda-return.csv)",
   "dqc:clauseOf": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dam-policy"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/PolicyClause/uk-dam-policy-dam-2",
   "@type": [
    "dqc:PolicyClause"
   ],
   "label": "DAM-2: Assign clear ownership and accountability for each data asset",
   "definition": "Area: Ownership. Strength: must. Toolkit: asset.owner and asset.steward; packs check they are recorded",
   "dqc:clauseOf": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dam-policy"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/PolicyClause/uk-dam-policy-dam-3",
   "@type": [
    "dqc:PolicyClause"
   ],
   "label": "DAM-3: Meet minimum standards for data quality through a DQAP or equivalent",
   "definition": "Area: Quality. Strength: must. Toolkit: Rules, baseline, issues framework scoring, DQAP workbook",
   "dqc:clauseOf": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dam-policy"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/PolicyClause/uk-dam-policy-dam-4",
   "@type": [
    "dqc:PolicyClause"
   ],
   "label": "DAM-4: Meet minimum standards for discoverability",
   "definition": "Area: Discoverability. Strength: must. Toolkit: Metadata assessment (20 checks); DQV and DCAT output",
   "dqc:clauseOf": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dam-policy"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/PolicyClause/uk-dam-policy-dam-5",
   "@type": [
    "dqc:PolicyClause"
   ],
   "label": "DAM-5: Meet minimum standards for interoperability",
   "definition": "Area: Interoperability. Strength: must. Toolkit: Identifier checks (UPRN, GSS, NHS number) and value sets",
   "dqc:clauseOf": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dam-policy"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/PolicyClause/uk-dam-policy-dam-6",
   "@type": [
    "dqc:PolicyClause"
   ],
   "label": "DAM-6: Review asset records at least every 12 months",
   "definition": "Area: Review. Strength: must. Toolkit: Metadata check DAM-4; history and schedules in the pipeline",
   "dqc:clauseOf": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dam-policy"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/PolicyClause/uk-dqap-dqap-1",
   "@type": [
    "dqc:PolicyClause"
   ],
   "label": "DQAP-1: Identify critical data and the data items that matter most",
   "definition": "Area: Process. Strength: should. Toolkit: Criticality matrix tab; importance 1-4",
   "dqc:clauseOf": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dqap"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/PolicyClause/uk-dqap-dqap-2",
   "@type": [
    "dqc:PolicyClause"
   ],
   "label": "DQAP-2: Identify data quality rules, dimensions and agreed thresholds",
   "definition": "Area: Process. Strength: should. Toolkit: Rules files, rule library, plain English drafting",
   "dqc:clauseOf": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dqap"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/PolicyClause/uk-dqap-dqap-3",
   "@type": [
    "dqc:PolicyClause"
   ],
   "label": "DQAP-3: Assess current quality, log issues and set a baseline",
   "definition": "Area: Process. Strength: should. Toolkit: dqkit check and run; history",
   "dqc:clauseOf": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dqap"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/PolicyClause/uk-dqap-dqap-4",
   "@type": [
    "dqc:PolicyClause"
   ],
   "label": "DQAP-4: Prioritise improvements and set goals using impact and risk",
   "definition": "Area: Process. Strength: should. Toolkit: Issues framework scoring; priorities and resolution timescales",
   "dqc:clauseOf": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dqap"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/PolicyClause/uk-dqap-dqap-5",
   "@type": [
    "dqc:PolicyClause"
   ],
   "label": "DQAP-5: Identify root causes, choose and own actions",
   "definition": "Area: Process. Strength: should. Toolkit: Causes and Actions tabs; control points; containment, corrective, preventive",
   "dqc:clauseOf": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dqap"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/PolicyClause/uk-dqap-dqap-6",
   "@type": [
    "dqc:PolicyClause"
   ],
   "label": "DQAP-6: Report quality to stakeholders, including limitations",
   "definition": "Area: Process. Strength: should. Toolkit: Run summary, trust level, DQV metadata, case study drafts",
   "dqc:clauseOf": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dqap"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/PolicyClause/uk-dqap-dqap-7",
   "@type": [
    "dqc:PolicyClause"
   ],
   "label": "DQAP-7: Repeat measurement, track trends, refine rules",
   "definition": "Area: Process. Strength: should. Toolkit: Weekly pipeline, history, ageing, escalation",
   "dqc:clauseOf": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dqap"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/PolicyClause/uk-dqap-if-1",
   "@type": [
    "dqc:PolicyClause"
   ],
   "label": "IF-1: Combined score = importance of purpose x impact of the issue",
   "definition": "Area: Scoring. Strength: method. Toolkit: framework.py (exact)",
   "dqc:clauseOf": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dqap"
    }
   ]
  },
  {
   "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/PolicyClause/uk-dqap-if-2",
   "@type": [
    "dqc:PolicyClause"
   ],
   "label": "IF-2: Target ranges by combined score: 75-90, 90-97.5, 97.5-99.9, 99.9-100",
   "definition": "Area: Scoring. Strength: method. Toolkit: Target policies low, mid, high",
   "dqc:clauseOf": [
    {
     "@id": "https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dqap"
    }
