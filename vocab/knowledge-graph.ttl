  rdfs:label "IDC-2: Every designated asset has a named data owner or IAO; name a successor when an owner leaves; review metadata every 12 months"@en ;
  skos:definition "Area: Ownership. Strength: must. Toolkit: DQAP Details (owner, steward, custodian, IAO, next review); annual review note template; CDA return gds_dataowner and review dates"@en ;
  dqc:clauseOf <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-identify-cda> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/PolicyClause/uk-data-ownership-model-do-1> a dqc:PolicyClause ;
  rdfs:label "DO-1: Data owner, data steward and data custodian roles; owner and steward names and roles kept in metadata; ownership reviewed annually"@en ;
  skos:definition "Area: Ownership. Strength: must. Toolkit: RACI tab; DQAP Details; Weaver contact point (team or role)"@en ;
  dqc:clauseOf <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-data-ownership-model> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/PolicyClause/uk-dqap-dqap-8> a dqc:PolicyClause ;
  rdfs:label "DQAP-8: Stakeholder list and communication plan, with target and actual resolution dates"@en ;
  skos:definition "Area: Reporting. Strength: should. Toolkit: Communication plan tab; Issues log target and actual resolution dates"@en ;
  dqc:clauseOf <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dqap> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/PolicyClause/uk-dqap-if-5> a dqc:PolicyClause ;
  rdfs:label "IF-5: High band starts halfway between the Middle band start and the target"@en ;
  skos:definition "Area: Method. Strength: method. Toolkit: framework.py follows the stated rule (97.5% target: High band from 96.25%)"@en ;
  dqc:clauseOf <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dqap> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Pack/ai-ml-readiness> a dqc:Pack ;
  rdfs:label "AI and machine learning data readiness (ISO/IEC 5259)"@en ;
  skos:definition "Checks that matter before data trains or feeds a model - completeness, accuracy, representativeness across groups, currency and documentation."@en ;
  dqc:implements <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/iso-iec-5259> ;
  dqc:requires <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ai-ml-readiness-ai-1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ai-ml-readiness-ai-2>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ai-ml-readiness-ai-3>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ai-ml-readiness-ai-4>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ai-ml-readiness-ai-5>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ai-ml-readiness-ai-6> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ai-ml-readiness-ai-1> a dqc:Requirement ;
  rdfs:label "AI-1: Completeness and accuracy of features are measured."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/completeness>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ai-ml-readiness-ai-2> a dqc:Requirement ;
  rdfs:label "AI-2: Representativeness - groups of people are compared and defaulted characteristics counted."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/group-disparity>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/not-unknown> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ai-ml-readiness-ai-3> a dqc:Requirement ;
  rdfs:label "AI-3: Duplicates are controlled so records aren't over-weighted."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/uniqueness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ai-ml-readiness-ai-4> a dqc:Requirement ;
  rdfs:label "AI-4: Currency of the training data is checked."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/timeliness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ai-ml-readiness-ai-5> a dqc:Requirement ;
  rdfs:label "AI-5: Provenance and intended use are documented."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ai-ml-readiness-ai-6> a dqc:Requirement ;
  rdfs:label "AI-6: Label quality and data drift are assessed for the model."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Pack/ess-output-quality> a dqc:Pack ;
  rdfs:label "ESS output quality dimensions"@en ;
  skos:definition "Reports against the European Statistical System output quality dimensions, which UK statistics guidance also uses."@en ;
  dqc:implements <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/ess-qaf>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Organisation/ess-cop> ;
  dqc:requires <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ess-output-quality-ess-r>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ess-output-quality-ess-a>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ess-output-quality-ess-t>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ess-output-quality-ess-c>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ess-output-quality-ess-ac> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ess-output-quality-ess-r> a dqc:Requirement ;
  rdfs:label "ESS-R: Relevance - user needs are recorded."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ess-output-quality-ess-a> a dqc:Requirement ;
  rdfs:label "ESS-A: Accuracy and reliability are measured."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ess-output-quality-ess-t> a dqc:Requirement ;
  rdfs:label "ESS-T: Timeliness and punctuality are monitored."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/timeliness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ess-output-quality-ess-c> a dqc:Requirement ;
  rdfs:label "ESS-C: Coherence and comparability - series have no gaps and use consistent codes."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/no-gaps>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/identifier>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/in-set> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ess-output-quality-ess-ac> a dqc:Requirement ;
  rdfs:label "ESS-AC: Accessibility and clarity - measures are labelled."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/header-has-unit> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Pack/fair> a dqc:Pack ;
  rdfs:label "FAIR principles"@en ;
  skos:definition "Findable, accessible, interoperable and reusable - mostly about metadata and formats."@en ;
  dqc:implements <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/fair> ;
  dqc:requires <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/fair-f>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/fair-a>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/fair-i>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/fair-r> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/fair-f> a dqc:Requirement ;
  rdfs:label "F: Findable - the asset has a persistent identifier."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/fair-a> a dqc:Requirement ;
  rdfs:label "A: Accessible - access route and licence are stated."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/fair-i> a dqc:Requirement ;
  rdfs:label "I: Interoperable - values use shared codes and identifiers."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/identifier>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/in-set> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/fair-r> a dqc:Requirement ;
  rdfs:label "R: Reusable - quality is described in standard metadata."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Pack/imf-dqaf> a dqc:Pack ;
  rdfs:label "IMF Data Quality Assessment Framework (DQAF)"@en ;
  skos:definition "For macroeconomic and financial statistics - links results to the IMF DQAF's prerequisites and five quality dimensions. Paraphrased headings; check the IMF framework for the full requirements."@en ;
  dqc:implements <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/imf-dqaf>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Organisation/imf-dqaf> ;
  dqc:requires <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/imf-dqaf-dqaf-0>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/imf-dqaf-dqaf-1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/imf-dqaf-dqaf-2a>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/imf-dqaf-dqaf-2b>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/imf-dqaf-dqaf-3>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/imf-dqaf-dqaf-4a>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/imf-dqaf-dqaf-4b>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/imf-dqaf-dqaf-4c>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/imf-dqaf-dqaf-5> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/imf-dqaf-dqaf-0> a dqc:Requirement ;
  rdfs:label "DQAF-0: Prerequisites of quality - responsibility and resources are recorded."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/imf-dqaf-dqaf-1> a dqc:Requirement ;
  rdfs:label "DQAF-1: Assurances of integrity - professionalism, transparency and ethical standards."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/imf-dqaf-dqaf-2a> a dqc:Requirement ;
  rdfs:label "DQAF-2a: Methodological soundness - concepts and classifications are applied consistently."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/validity> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/imf-dqaf-dqaf-2b> a dqc:Requirement ;
  rdfs:label "DQAF-2b: Methodological soundness - codes follow agreed classifications."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/identifier>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/in-set>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/regex> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/imf-dqaf-dqaf-3> a dqc:Requirement ;
  rdfs:label "DQAF-3: Accuracy and reliability - source data and results are assessed."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/completeness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/imf-dqaf-dqaf-4a> a dqc:Requirement ;
  rdfs:label "DQAF-4a: Serviceability - periodicity and timeliness are monitored."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/freshness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/imf-dqaf-dqaf-4b> a dqc:Requirement ;
  rdfs:label "DQAF-4b: Serviceability - series are consistent over time, with no gaps."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/no-gaps> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/imf-dqaf-dqaf-4c> a dqc:Requirement ;
  rdfs:label "DQAF-4c: Serviceability - revisions are tracked over repeated measurements."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/imf-dqaf-dqaf-5> a dqc:Requirement ;
  rdfs:label "DQAF-5: Accessibility - data and metadata are clear: measures carry units."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/header-has-unit> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Pack/isle-of-man-code-of-practice> a dqc:Pack ;
  rdfs:label "Isle of Man Code of Practice for Statistics (draft pack)"@en ;
  skos:definition "DRAFT, not yet checked with Statistics Isle of Man. For Isle of Man Government departments: links results to the three pillars of the Isle of Man Code of Practice for Statistics (Trustworthiness, Quality and Value), published by the Cabinet Office. Pillar-level only and paraphrased; the code itself is the authority."@en ;
  dqc:implements <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-code-of-practice-3> ;
  dqc:requires <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/isle-of-man-code-of-practice-im-t1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/isle-of-man-code-of-practice-im-t2>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/isle-of-man-code-of-practice-im-q1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/isle-of-man-code-of-practice-im-q2>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/isle-of-man-code-of-practice-im-q3>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/isle-of-man-code-of-practice-im-v1> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/isle-of-man-code-of-practice-im-t1> a dqc:Requirement ;
  rdfs:label "IM-T1: Trustworthiness - the people, processes and systems behind the statistics are accountable; an owner is named."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/isle-of-man-code-of-practice-im-t2> a dqc:Requirement ;
  rdfs:label "IM-T2: Trustworthiness - statistics are released openly and impartially (check against the code)."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/isle-of-man-code-of-practice-im-q1> a dqc:Requirement ;
  rdfs:label "IM-Q1: Quality - data are accurate and complete enough for their use."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/completeness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/isle-of-man-code-of-practice-im-q2> a dqc:Requirement ;
  rdfs:label "IM-Q2: Quality - definitions and methods are consistent and valid."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/validity>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/consistency> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/isle-of-man-code-of-practice-im-q3> a dqc:Requirement ;
  rdfs:label "IM-Q3: Quality - statistics are timely."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/freshness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/isle-of-man-code-of-practice-im-v1> a dqc:Requirement ;
  rdfs:label "IM-V1: Value - statistics meet users' needs and are accessible."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Pack/iso-19157-geospatial> a dqc:Pack ;
  rdfs:label "Geospatial data quality (ISO 19157-1)"@en ;
  skos:definition "Maps results to the ISO 19157 data quality elements used for geographic information."@en ;
  dqc:implements <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/iso-19157>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-geospatial-qfair> ;
  dqc:requires <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-19157-geospatial-geo-1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-19157-geospatial-geo-2>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-19157-geospatial-geo-3>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-19157-geospatial-geo-4>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-19157-geospatial-geo-5> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-19157-geospatial-geo-1> a dqc:Requirement ;
  rdfs:label "GEO-1: Completeness (commission and omission) is measured."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/completeness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-19157-geospatial-geo-2> a dqc:Requirement ;
  rdfs:label "GEO-2: Logical consistency - formats, domains and topology rules are checked."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/validity>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/consistency> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-19157-geospatial-geo-3> a dqc:Requirement ;
  rdfs:label "GEO-3: Geographic identifiers (UPRN, GSS codes, postcodes) are valid."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/identifier> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-19157-geospatial-geo-4> a dqc:Requirement ;
  rdfs:label "GEO-4: Temporal quality is checked."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/timeliness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-19157-geospatial-geo-5> a dqc:Requirement ;
  rdfs:label "GEO-5: Positional and thematic accuracy are assessed against a reference."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Pack/iso-8000-8> a dqc:Pack ;
  rdfs:label "ISO 8000-8 - syntactic, semantic and pragmatic quality"@en ;
  skos:definition "Groups results the ISO 8000-8 way - does the data conform to its format, does it correctly represent the thing, and is it fit for the use."@en ;
  dqc:implements <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/iso-8000>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Organisation/iso> ;
  dqc:requires <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-8000-8-syn>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-8000-8-sem>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-8000-8-pra> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-8000-8-syn> a dqc:Requirement ;
  rdfs:label "SYN: Syntactic quality - values conform to the agreed formats and code lists."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/validity> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-8000-8-sem> a dqc:Requirement ;
  rdfs:label "SEM: Semantic quality - values correctly represent the real-world thing."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/consistency> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-8000-8-pra> a dqc:Requirement ;
  rdfs:label "PRA: Pragmatic quality - the data is fit for its stated use."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Pack/iso-iec-25012> a dqc:Pack ;
  rdfs:label "ISO/IEC 25012 data quality model"@en ;
  skos:definition "Reports results against the 15 ISO/IEC 25012 characteristics, showing which the data rules measure and which need system or process evidence."@en ;
  dqc:implements <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/iso-iec-25012> ;
  dqc:requires <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-iec-25012-inh>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-iec-25012-both>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-iec-25012-sys> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-iec-25012-inh> a dqc:Requirement ;
  rdfs:label "INH: Inherent characteristics measured - accuracy, completeness, consistency, currentness."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/completeness>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/consistency>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/timeliness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-iec-25012-both> a dqc:Requirement ;
  rdfs:label "BOTH: Understandability and traceability evidenced through metadata."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/iso-iec-25012-sys> a dqc:Requirement ;
  rdfs:label "SYS: System-dependent characteristics (availability, portability, recoverability) assessed."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Pack/jersey-code-of-practice> a dqc:Pack ;
  rdfs:label "Jersey Code of Practice for Statistics (draft pack)"@en ;
  skos:definition "DRAFT, not yet checked with Statistics Jersey. For public authorities in Jersey: links results to the three pillars of Jersey's Code of Practice for Statistics (Trustworthiness, Quality and Value), published by the Statistics Users Group under the Statistics and Census (Jersey) Law 2018. Pillar-level only and paraphrased; the code's own principles and practices are the authority. Producers of official statistics also follow the separate Code of Practice for Official Statistics."@en ;
  dqc:implements <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-code-of-practice-3> ;
  dqc:requires <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/jersey-code-of-practice-je-t1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/jersey-code-of-practice-je-t2>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/jersey-code-of-practice-je-q1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/jersey-code-of-practice-je-q2>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/jersey-code-of-practice-je-q3>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/jersey-code-of-practice-je-v1> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/jersey-code-of-practice-je-t1> a dqc:Requirement ;
  rdfs:label "JE-T1: Trustworthiness - someone is accountable for the statistics and the data behind them."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/jersey-code-of-practice-je-t2> a dqc:Requirement ;
  rdfs:label "JE-T2: Trustworthiness - statistics are released openly and orderly, with integrity (check against the code's release practices)."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/jersey-code-of-practice-je-q1> a dqc:Requirement ;
  rdfs:label "JE-Q1: Quality - data are accurate and complete enough for their use."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/completeness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/jersey-code-of-practice-je-q2> a dqc:Requirement ;
  rdfs:label "JE-Q2: Quality - methods and classifications are applied consistently."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/validity>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/consistency> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/jersey-code-of-practice-je-q3> a dqc:Requirement ;
  rdfs:label "JE-Q3: Quality - data are timely and kept up to date."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/freshness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/jersey-code-of-practice-je-v1> a dqc:Requirement ;
  rdfs:label "JE-V1: Value - users' needs are understood and statistics are accessible and clearly explained."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Pack/ndl-curation> a dqc:Pack ;
  rdfs:label "National Data Library - curated data page"@en ;
  skos:definition "Scenario pack for assets curated into the National Data Library - CDA metadata, publisher, update frequency and inclusion signposting."@en ;
  dqc:implements <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dam-policy>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-cda-metadata>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/fair> ;
  dqc:requires <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ndl-curation-ndl-1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ndl-curation-ndl-2>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ndl-curation-ndl-3>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ndl-curation-ndl-4>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ndl-curation-ndl-5> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ndl-curation-ndl-1> a dqc:Requirement ;
  rdfs:label "NDL-1: The publisher (owner organisation) is named."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ndl-curation-ndl-2> a dqc:Requirement ;
  rdfs:label "NDL-2: The asset has a page identifier."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ndl-curation-ndl-3> a dqc:Requirement ;
  rdfs:label "NDL-3: The update frequency is stated."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ndl-curation-ndl-4> a dqc:Requirement ;
  rdfs:label "NDL-4: Chart data say what they measure."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/header-has-unit> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/ndl-curation-ndl-5> a dqc:Requirement ;
  rdfs:label "NDL-5: The latest period is recent enough."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/freshness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Pack/nhs-dqmi-style> a dqc:Pack ;
  rdfs:label "NHS DQMI-style index"@en ;
  skos:definition "An indicative score built the way NHS England's Data Quality Maturity Index is - valid and complete data items, adjusted for coverage. Not the official DQMI."@en ;
  dqc:implements <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/nhs-dqmi> ;
  dqc:requires <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/nhs-dqmi-style-dqmi-1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/nhs-dqmi-style-dqmi-2>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/nhs-dqmi-style-dqmi-3>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/nhs-dqmi-style-dqmi-4> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/nhs-dqmi-style-dqmi-1> a dqc:Requirement ;
  rdfs:label "DQMI-1: Completeness of each data item is measured."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/not-null> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/nhs-dqmi-style-dqmi-2> a dqc:Requirement ;
  rdfs:label "DQMI-2: Validity of each data item is measured against its code list or format."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/in-set>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/regex>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/identifier>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/type>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/range> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/nhs-dqmi-style-dqmi-3> a dqc:Requirement ;
  rdfs:label "DQMI-3: Use of default values such as Not known is measured."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/not-unknown> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/nhs-dqmi-style-dqmi-4> a dqc:Requirement ;
  rdfs:label "DQMI-4: Coverage (periods submitted against periods expected) is recorded."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Pack/uk-dam-cda> a dqc:Pack ;
  rdfs:label "UK data asset management policy - critical data assets"@en ;
  skos:definition "For critical data assets under the 2026 data asset management (DAM) policy, with the DQAP guide and issues framework."@en ;
  dqc:implements <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dam-policy>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-dqap>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-cda-metadata> ;
  dqc:requires <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dam-1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dam-2>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dam-3>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dam-4>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dqap-1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dqap-2>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dqap-3>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dqap-4>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dqap-5>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dqap-6>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dqap-7>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-cda-m1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-inc-1> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dam-1> a dqc:Requirement ;
  rdfs:label "DAM-1: A named data owner organisation is recorded for the asset."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dam-2> a dqc:Requirement ;
  rdfs:label "DAM-2: A data steward (or equivalent role) is recorded."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dam-3> a dqc:Requirement ;
  rdfs:label "DAM-3: A data quality action plan (DQAP) or equivalent exists and is linked."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dam-4> a dqc:Requirement ;
  rdfs:label "DAM-4: Importance of purpose is set (1-4) so targets follow the issues framework."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dqap-1> a dqc:Requirement ;
  rdfs:label "DQAP-1: Rules exist for critical data items (DQAP step 2)."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dqap-2> a dqc:Requirement ;
  rdfs:label "DQAP-2: Core dimensions are measured - completeness, validity and timeliness at least."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/completeness>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/validity>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/timeliness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dqap-3> a dqc:Requirement ;
  rdfs:label "DQAP-3: A baseline is recorded (DQAP step 3)."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dqap-4> a dqc:Requirement ;
  rdfs:label "DQAP-4: Issues are prioritised with the data quality issues framework (DQAP step 4)."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dqap-5> a dqc:Requirement ;
  rdfs:label "DQAP-5: Root causes and actions are recorded for open issues (DQAP step 5)."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dqap-6> a dqc:Requirement ;
  rdfs:label "DQAP-6: Results are reported to users (DQAP step 6)."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-dqap-7> a dqc:Requirement ;
  rdfs:label "DQAP-7: Quality is re-measured over time (DQAP step 7)."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-cda-m1> a dqc:Requirement ;
  rdfs:label "CDA-M1: The asset's metadata includes its identifier (IRI)."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-dam-cda-inc-1> a dqc:Requirement ;
  rdfs:label "INC-1: Where the asset holds personal data, representativeness is checked."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Pack/uk-gdqf> a dqc:Pack ;
  rdfs:label "Government Data Quality Framework"@en ;
  skos:definition "The 2020 cross-government framework - 5 principles, the data lifecycle and 6 core dimensions. Good for any public body."@en ;
  dqc:implements <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-gdqf> ;
  dqc:requires <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-gdqf-gdqf-p1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-gdqf-gdqf-p2>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-gdqf-gdqf-p3>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-gdqf-gdqf-p4>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-gdqf-gdqf-p5>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-gdqf-gdqf-d> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-gdqf-gdqf-p1> a dqc:Requirement ;
  rdfs:label "GDQF-P1: Commit to data quality - an accountable owner is recorded."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-gdqf-gdqf-p2> a dqc:Requirement ;
  rdfs:label "GDQF-P2: Know your users and their needs - the primary use is recorded."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-gdqf-gdqf-p3> a dqc:Requirement ;
  rdfs:label "GDQF-P3: Assess quality throughout the data lifecycle - rules sit at source, in the pipeline or in reporting."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-gdqf-gdqf-p4> a dqc:Requirement ;
  rdfs:label "GDQF-P4: Communicate data quality clearly - results are published as metadata."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-gdqf-gdqf-p5> a dqc:Requirement ;
  rdfs:label "GDQF-P5: Anticipate changes affecting data quality - quality is tracked over time."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-gdqf-gdqf-d> a dqc:Requirement ;
  rdfs:label "GDQF-D: The six core dimensions are each measured where they apply."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/completeness>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/uniqueness>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/consistency>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/timeliness>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/validity>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Pack/uk-personal-data-accuracy> a dqc:Pack ;
  rdfs:label "UK GDPR accuracy principle (personal data)"@en ;
  skos:definition "Evidence that personal data is accurate, kept up to date where necessary, and that inaccuracies are corrected - plus fairness across groups."@en ;
  dqc:implements <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-ico-accuracy> ;
  dqc:requires <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-personal-data-accuracy-acc-1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-personal-data-accuracy-acc-2>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-personal-data-accuracy-acc-3>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-personal-data-accuracy-acc-4>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-personal-data-accuracy-acc-5>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-personal-data-accuracy-acc-6> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-personal-data-accuracy-acc-1> a dqc:Requirement ;
  rdfs:label "ACC-1: Personal data columns are declared."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-personal-data-accuracy-acc-2> a dqc:Requirement ;
  rdfs:label "ACC-2: Accuracy of personal data is measured."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-personal-data-accuracy-acc-3> a dqc:Requirement ;
  rdfs:label "ACC-3: Identifiers are validated so records link to the right person."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/identifier> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-personal-data-accuracy-acc-4> a dqc:Requirement ;
  rdfs:label "ACC-4: Currency is checked where the purpose needs up-to-date data."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/timeliness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-personal-data-accuracy-acc-5> a dqc:Requirement ;
  rdfs:label "ACC-5: Quality is compared across groups of people so no group is disadvantaged."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/group-disparity> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-personal-data-accuracy-acc-6> a dqc:Requirement ;
  rdfs:label "ACC-6: There is a route to correct inaccurate data (rectification)."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Pack/uk-statistics> a dqc:Pack ;
  rdfs:label "Official statistics - Code of Practice 3.0 and QAAD"@en ;
  skos:definition "For statistics producers - links data quality results to the Code of Practice for Statistics (Edition 3.0) quality pillar and the QAAD toolkit for administrative data."@en ;
  dqc:implements <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-code-of-practice-3>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-qaad>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/uk-analysis-function-quality> ;
  dqc:requires <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-statistics-cop-q1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-statistics-cop-q2>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-statistics-cop-q3>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-statistics-cop-v1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-statistics-cop-t1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-statistics-qaad-1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-statistics-qaad-2> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-statistics-cop-q1> a dqc:Requirement ;
  rdfs:label "COP-Q1: Suitable data sources - the source and supplier relationship are recorded."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-statistics-cop-q2> a dqc:Requirement ;
  rdfs:label "COP-Q2: Sound methods - validity and consistency are checked."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/validity>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/consistency> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-statistics-cop-q3> a dqc:Requirement ;
  rdfs:label "COP-Q3: Assured quality - accuracy is assessed and limitations stated."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-statistics-cop-v1> a dqc:Requirement ;
  rdfs:label "COP-V1: Value - outputs say what they measure (units and labels)."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/header-has-unit> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-statistics-cop-t1> a dqc:Requirement ;
  rdfs:label "COP-T1: Timeliness of release is monitored."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/freshness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-statistics-qaad-1> a dqc:Requirement ;
  rdfs:label "QAAD-1: QAAD assurance level (A0 to A3) is recorded for administrative sources."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/uk-statistics-qaad-2> a dqc:Requirement ;
  rdfs:label "QAAD-2: Supplier quality checks and communication are documented."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Pack/un-nqaf> a dqc:Pack ;
  rdfs:label "UN National Quality Assurance Framework (NQAF)"@en ;
  skos:definition "For statistics offices of any size, including Crown Dependencies, Overseas Territories and Commonwealth partners - links results to the four levels of the UN NQAF Manual (2019). Paraphrased headings; check the manual for the full requirements."@en ;
  dqc:implements <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Framework/un-nqaf>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Organisation/un-nqaf> ;
  dqc:requires <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-s1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-s2>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-i1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-p1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-p2>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-p3>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-o1>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-o2>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-o3>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-o4>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-o5> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-s1> a dqc:Requirement ;
  rdfs:label "NQAF-S1: Managing the statistical system - who is accountable for the data is recorded."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-s2> a dqc:Requirement ;
  rdfs:label "NQAF-S2: Managing the statistical system - co-ordination with other producers and suppliers is documented."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-i1> a dqc:Requirement ;
  rdfs:label "NQAF-I1: Institutional environment - professional independence, impartiality and confidentiality are assured."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-p1> a dqc:Requirement ;
  rdfs:label "NQAF-P1: Statistical processes - sound methods: validity is checked."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/validity> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-p2> a dqc:Requirement ;
  rdfs:label "NQAF-P2: Statistical processes - accuracy is measured."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-p3> a dqc:Requirement ;
  rdfs:label "NQAF-P3: Statistical processes - quality is measured repeatedly, not once."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-o1> a dqc:Requirement ;
  rdfs:label "NQAF-O1: Statistical outputs - relevance: the primary use is recorded."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-o2> a dqc:Requirement ;
  rdfs:label "NQAF-O2: Statistical outputs - timeliness and punctuality are monitored."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/freshness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-o3> a dqc:Requirement ;
  rdfs:label "NQAF-O3: Statistical outputs - coherence and comparability: consistent codes and no gaps."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/no-gaps>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/identifier>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/in-set> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-o4> a dqc:Requirement ;
  rdfs:label "NQAF-O4: Statistical outputs - accessibility and clarity: measures are labelled."@en ;
  dqc:evidencedBy <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Check/header-has-unit> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Requirement/un-nqaf-nqaf-o5> a dqc:Requirement ;
  rdfs:label "NQAF-O5: Leaving no one behind - quality is checked across groups of people where personal data is held."@en .
