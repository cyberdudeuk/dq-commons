<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/accuracy> a dqc:Term, skos:Concept ;
  rdfs:label "Accuracy"@en ;
  skos:definition "How well data describes the real thing or event it is about."@en ;
  skos:altLabel "Correctness"@en ;
  skos:altLabel "Precision of values"@en ;
  skos:broader <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-dimension> ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/validity>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/root-cause-analysis> ;
  dqc:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/completeness> a dqc:Term, skos:Concept ;
  rdfs:label "Completeness"@en ;
  skos:definition "How much of the data that should be there is there."@en ;
  skos:altLabel "Coverage"@en ;
  skos:altLabel "Fill rate"@en ;
  skos:broader <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-dimension> ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/representativeness> ;
  dqc:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/completeness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/consistency> a dqc:Term, skos:Concept ;
  rdfs:label "Consistency"@en ;
  skos:definition "Whether the same thing is recorded the same way in different places."@en ;
  skos:altLabel "Coherence"@en ;
  skos:broader <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-dimension> ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/validity> ;
  dqc:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/consistency> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/timeliness> a dqc:Term, skos:Concept ;
  rdfs:label "Timeliness"@en ;
  skos:definition "Whether data describes reality at the time it is needed."@en ;
  skos:altLabel "Currency"@en ;
  skos:altLabel "Freshness"@en ;
  skos:altLabel "Punctuality"@en ;
  skos:broader <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-dimension> ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/escalation> ;
  dqc:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/timeliness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/uniqueness> a dqc:Term, skos:Concept ;
  rdfs:label "Uniqueness"@en ;
  skos:definition "Nothing is recorded more than once."@en ;
  skos:altLabel "Deduplication"@en ;
  skos:altLabel "No duplicates"@en ;
  skos:broader <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-dimension> ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/master-data> ;
  dqc:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/uniqueness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/validity> a dqc:Term, skos:Concept ;
  rdfs:label "Validity"@en ;
  skos:definition "Data follows its agreed format, type and allowed values."@en ;
  skos:altLabel "Conformity"@en ;
  skos:altLabel "Format compliance"@en ;
  skos:broader <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-dimension> ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/accuracy>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-contract> ;
  dqc:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/validity> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/representativeness> a dqc:Term, skos:Concept ;
  rdfs:label "Representativeness"@en ;
  skos:definition "Data covers the groups of people or places it should, without gaps that hide some of them."@en ;
  skos:altLabel "Inclusion"@en ;
  skos:altLabel "Coverage of groups"@en ;
  skos:broader <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-dimension> ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/completeness> ;
  dqc:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/representativeness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/critical-data-asset-cda> a dqc:Term, skos:Concept ;
  rdfs:label "Critical data asset (CDA)"@en ;
  skos:definition "A data asset of high value shared across government, in scope of the DAM policy."@en ;
  skos:altLabel "CDA"@en ;
  skos:altLabel "Essential shared data asset"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/metadata>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-owner> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/q-fair> a dqc:Term, skos:Concept ;
  rdfs:label "Q-FAIR"@en ;
  skos:definition "The Geospatial Commission's approach: data of the right Quality that is also Findable, Accessible, Interoperable and Reusable, rated Good, Improving or Attention required."@en ;
  skos:altLabel "Quality and FAIR"@en ;
  skos:altLabel "FAIR plus quality"@en ;
  skos:broader <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-dimension> ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/critical-data-asset-cda>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/metadata> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-baseline> a dqc:Term, skos:Concept ;
  rdfs:label "Data quality baseline"@en ;
  skos:definition "The first measurement of an asset's quality against its rules, used as the benchmark for every later report."@en ;
  skos:altLabel "Baseline return"@en ;
  skos:altLabel "First measurement"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-rule>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/critical-data-asset-cda> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-action-plan-dqap> a dqc:Term, skos:Concept ;
  rdfs:label "Data quality action plan (DQAP)"@en ;
  skos:definition "The plan that records an asset's rules, baseline, issues, actions and reporting."@en ;
  skos:altLabel "DQAP"@en ;
  skos:altLabel "Action plan"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-issues-framework>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/root-cause-analysis> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-issues-framework> a dqc:Term, skos:Concept ;
  rdfs:label "Data quality issues framework"@en ;
  skos:definition "GOV.UK method that sets targets from importance and impact, then scores how far below target a rule is."@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/combined-score>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-action-plan-dqap> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/combined-score> a dqc:Term, skos:Concept ;
  rdfs:label "Combined score"@en ;
  skos:definition "Importance of purpose (1-4) times impact of the rule failing (1-4)."@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-issues-framework> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/trust-level> a dqc:Term, skos:Concept ;
  rdfs:label "Trust level"@en ;
  skos:definition "Untrustworthy, Requires improvement, Useable or Trustworthy - says how data may be used and shared."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/control-point> a dqc:Term, skos:Concept ;
  rdfs:label "Control point"@en ;
  skos:definition "Where a control belongs - at source (capture), in the pipeline, or in reporting."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/escalation> a dqc:Term, skos:Concept ;
  rdfs:label "Escalation"@en ;
  skos:definition "Raising an issue to the data owner or governance board when it stays open longer than allowed."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/dqv> a dqc:Term, skos:Concept ;
  rdfs:label "DQV"@en ;
  skos:definition "W3C Data Quality Vocabulary - a standard way to publish quality results as metadata."@en ;
  skos:altLabel "Data Quality Vocabulary"@en ;
  skos:broader <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/metadata> ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/dcat> ;
  dqc:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/MetadataStandard/dqv> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/dcat> a dqc:Term, skos:Concept ;
  rdfs:label "DCAT"@en ;
  skos:definition "W3C vocabulary for describing datasets in catalogues."@en ;
  skos:altLabel "Data Catalog Vocabulary"@en ;
  skos:broader <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/metadata> ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/dqv> ;
  dqc:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/MetadataStandard/dcat-v3> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/pack> a dqc:Term, skos:Concept ;
  rdfs:label "Pack"@en ;
  skos:definition "A profile that applies a framework, standard or scenario to the kit's results."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/crosswalk> a dqc:Term, skos:Concept ;
  rdfs:label "Crosswalk"@en ;
  skos:definition "A table that maps one framework's dimensions or terms to another's."@en ;
  skos:altLabel "Mapping"@en ;
  skos:altLabel "Concordance"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/pack>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/thesaurus> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/qaad> a dqc:Term, skos:Concept ;
  rdfs:label "QAAD"@en ;
  skos:definition "Quality Assurance of Administrative Data - OSR's toolkit and assurance levels A0 to A3."@en ;
  skos:altLabel "Quality Assurance of Administrative Data"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-dimension>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-owner> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/dqmi> a dqc:Term, skos:Concept ;
  rdfs:label "DQMI"@en ;
  skos:definition "NHS England's Data Quality Maturity Index for provider datasets."@en ;
  skos:altLabel "Data Quality Maturity Index"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-dimension> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-owner> a dqc:Term, skos:Concept ;
  rdfs:label "Data owner"@en ;
  skos:definition "The senior person accountable for an asset's fitness, priorities and acceptable risk."@en ;
  skos:altLabel "Information asset owner"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-steward>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/escalation> ;
  dqc:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Role/owner> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-steward> a dqc:Term, skos:Concept ;
  rdfs:label "Data steward"@en ;
  skos:definition "The person who runs the quality work day to day - rules, measurement, issues and reporting."@en ;
  skos:altLabel "Data custodian"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-owner>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-action-plan-dqap> ;
  dqc:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Role/steward> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/root-cause-analysis> a dqc:Term, skos:Concept ;
  rdfs:label "Root cause analysis"@en ;
  skos:definition "Finding why an issue happens (process, system or people) so the fix prevents it coming back."@en ;
  skos:altLabel "Five whys"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/containment>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-lineage> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/containment> a dqc:Term, skos:Concept ;
  rdfs:label "Containment"@en ;
  skos:definition "A quick action that limits harm while the real fix is made."@en .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/mcp> a dqc:Term, skos:Concept ;
  rdfs:label "MCP"@en ;
  skos:definition "Model Context Protocol - a standard way for AI agents to call tools such as this kit."@en ;
  skos:altLabel "Model Context Protocol"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/declarative>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/knowledge-graph> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/declarative> a dqc:Term, skos:Concept ;
  rdfs:label "Declarative"@en ;
  skos:definition "Saying what good looks like (rules, portfolios, packs) and letting the tools work out how to check it."@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-rule>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/mcp> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-dimension> a dqc:Term, skos:Concept ;
  rdfs:label "Data quality dimension"@en ;
  skos:definition "An aspect of data quality that can be measured, such as completeness, accuracy or timeliness."@en ;
  skos:altLabel "Quality characteristic"@en ;
  skos:altLabel "Quality criterion"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-rule> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-rule> a dqc:Term, skos:Concept ;
  rdfs:label "Data quality rule"@en ;
  skos:definition "A testable statement of what good data looks like for one data item, with a target pass rate."@en ;
  skos:altLabel "Quality check"@en ;
  skos:altLabel "Validation rule"@en ;
  skos:altLabel "Expectation"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-dimension>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-contract> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-contract> a dqc:Term, skos:Concept ;
  rdfs:label "Data contract"@en ;
  skos:definition "A written, testable agreement between the people who produce and use a dataset: its structure, quality rules and service levels."@en ;
  skos:altLabel "ODCS contract"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-rule>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/validity> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-lineage> a dqc:Term, skos:Concept ;
  rdfs:label "Data lineage"@en ;
  skos:definition "Where data came from and what happened to it on the way, from source to report."@en ;
  skos:altLabel "Provenance"@en ;
  skos:altLabel "Data flow"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/metadata>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/root-cause-analysis> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/metadata> a dqc:Term, skos:Concept ;
  rdfs:label "Metadata"@en ;
  skos:definition "Data that describes data: what it is, who owns it, how good it is and how to use it."@en ;
  skos:altLabel "Data description"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/dcat>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/dqv>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-lineage> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/master-data> a dqc:Term, skos:Concept ;
  rdfs:label "Master data"@en ;
  skos:definition "Core shared data about things like people, places and organisations, used across many systems."@en ;
  skos:altLabel "Reference entities"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/uniqueness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/reference-data> a dqc:Term, skos:Concept ;
  rdfs:label "Reference data"@en ;
  skos:definition "Agreed lists of codes and values, such as GSS geography codes, used to classify other data."@en ;
  skos:altLabel "Code lists"@en ;
  skos:altLabel "Value sets"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/validity> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/ontology> a dqc:Term, skos:Concept ;
  rdfs:label "Ontology"@en ;
  skos:definition "A formal model of the things in a domain and how they relate, which machines can reason with."@en ;
  skos:altLabel "Domain model"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/taxonomy>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/knowledge-graph>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/metadata> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/taxonomy> a dqc:Term, skos:Concept ;
  rdfs:label "Taxonomy"@en ;
  skos:definition "A hierarchy of categories, from broad to narrow."@en ;
  skos:altLabel "Classification"@en ;
  skos:altLabel "Concept scheme"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/ontology>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/thesaurus> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/thesaurus> a dqc:Term, skos:Concept ;
  rdfs:label "Thesaurus"@en ;
  skos:definition "A controlled vocabulary that records preferred terms, synonyms and broader, narrower and related terms."@en ;
  skos:altLabel "Controlled vocabulary"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/taxonomy>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/glossary> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/glossary> a dqc:Term, skos:Concept ;
  rdfs:label "Glossary"@en ;
  skos:definition "A list of terms with their definitions in plain English."@en ;
  skos:altLabel "Lexicon"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/thesaurus> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/knowledge-graph> a dqc:Term, skos:Concept ;
  rdfs:label "Knowledge graph"@en ;
  skos:definition "A network of things and the relationships between them, which people and machines can explore."@en ;
  skos:altLabel "Linked data graph"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/ontology> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-dictionary> a dqc:Term, skos:Concept ;
  rdfs:label "Data dictionary"@en ;
  skos:definition "A list of the data items in a dataset or system, with their meaning, type, format and rules."@en ;
  skos:altLabel "Data catalogue entry"@en ;
  skos:altLabel "Schema documentation"@en ;
  skos:related <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/metadata>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-contract> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-source> a dqc:Stage ;
  rdfs:label "Source data"@en ;
  skos:definition "A file, database table or catalogue (CSV, Excel, ODS, JSON, Parquet, SQL, CKAN)."@en ;
  dqc:flowsTo <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-measure> ;
  dqc:involves <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-lineage> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-rules> a dqc:Stage ;
  rdfs:label "Rules file"@en ;
  skos:definition "What good looks like, with targets from the issues framework."@en ;
  dqc:flowsTo <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-measure> ;
  dqc:involves <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-rule>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-contract> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-measure> a dqc:Stage ;
  rdfs:label "Measure"@en ;
  skos:definition "dqkit or the browser engine runs every rule."@en ;
  dqc:flowsTo <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-results> ;
  dqc:involves <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-dimension> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-results> a dqc:Stage ;
  rdfs:label "Results and history"@en ;
  skos:definition "Pass rates, targets and trends for each rule."@en ;
  dqc:flowsTo <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-issues>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-dqv> ;
  dqc:involves <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/trust-level> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-issues> a dqc:Stage ;
  rdfs:label "Issues and escalations"@en ;
  skos:definition "Below-target rules become prioritised issues; overdue ones escalate."@en ;
  dqc:flowsTo <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-return> ;
  dqc:involves <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-issues-framework>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/escalation>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-action-plan-dqap> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-dqv> a dqc:Stage ;
  rdfs:label "Quality metadata (DQV)"@en ;
  skos:definition "Results published as W3C Data Quality Vocabulary."@en ;
  dqc:flowsTo <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-catalogue> ;
  dqc:involves <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/dqv>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/MetadataStandard/dqv> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-catalogue> a dqc:Stage ;
  rdfs:label "Catalogue record"@en ;
  skos:definition "DCAT, schema.org or CKAN record, woven with quality metadata."@en ;
  dqc:flowsTo <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-return> ;
  dqc:involves <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/dcat>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/metadata>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/MetadataStandard/dcat-v3> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-return> a dqc:Stage ;
  rdfs:label "CDA return and dashboards"@en ;
  skos:definition "The critical data asset return and the portal's pipeline page."@en ;
  dqc:involves <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/critical-data-asset-cda> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/pb-identify> a dqc:Stage ;
  rdfs:label "1 Identify critical data"@en ;
  skos:definition "Register critical data assets, owners and the data items that matter most."@en ;
  dqc:flowsTo <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/pb-define> ;
  dqc:involves <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/critical-data-asset-cda>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-source> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/pb-define> a dqc:Stage ;
  rdfs:label "2 Define rules and targets"@en ;
  skos:definition "Plain-English rules, dimensions and targets, saved as a data contract."@en ;
  dqc:flowsTo <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/pb-baseline> ;
  dqc:involves <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-rule>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-contract>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-rules> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/pb-baseline> a dqc:Stage ;
  rdfs:label "3 Measure and baseline"@en ;
  skos:definition "Profile, run rules, log issues, break results down by group."@en ;
  dqc:flowsTo <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/pb-prioritise> ;
  dqc:involves <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-measure> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/pb-prioritise> a dqc:Stage ;
  rdfs:label "4 Prioritise"@en ;
  skos:definition "Score issues with the issues framework and write the action plan."@en ;
  dqc:flowsTo <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/pb-improve> ;
  dqc:involves <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-issues-framework>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/data-quality-action-plan-dqap> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/pb-improve> a dqc:Stage ;
  rdfs:label "5 Fix at source"@en ;
  skos:definition "Find root causes and fix where the data is created."@en ;
  dqc:flowsTo <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/pb-report> ;
  dqc:involves <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/escalation> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/pb-report> a dqc:Stage ;
  rdfs:label "6 Report openly"@en ;
  skos:definition "Data quality statement, DQV metadata and the CDA return."@en ;
  dqc:flowsTo <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/pb-sustain> ;
  dqc:involves <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-dqv>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/st-return> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/pb-sustain> a dqc:Stage ;
  rdfs:label "7 Monitor and sustain"@en ;
  skos:definition "Automated checks, trends, alerts and escalation."@en ;
  dqc:flowsTo <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/pb-review>, <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/pb-baseline> ;
  dqc:involves <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/trust-level> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/pb-review> a dqc:Stage ;
  rdfs:label "8 Annual review"@en ;
  skos:definition "Review the asset, rules and targets at least every 12 months."@en ;
  dqc:flowsTo <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/pb-identify> ;
  dqc:involves <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/critical-data-asset-cda> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/rt-policy> a dqc:Stage ;
  rdfs:label "Policy or framework"@en ;
  skos:definition "For example the DAM policy or the Code of Practice."@en ;
  dqc:flowsTo <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/rt-clause> ;
  dqc:involves <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/critical-data-asset-cda> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/rt-clause> a dqc:Stage ;
  rdfs:label "Clause"@en ;
  skos:definition "One requirement, broken down line by line."@en ;
  dqc:flowsTo <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/rt-pack> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/rt-pack> a dqc:Stage ;
  rdfs:label "Pack requirement"@en ;
  skos:definition "The clause as a testable requirement."@en ;
  dqc:flowsTo <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Stage/rt-evidence> ;
  dqc:involves <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Term/pack> .
