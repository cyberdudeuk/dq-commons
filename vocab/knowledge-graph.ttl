@prefix dqc: <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

dqc:Dataset a owl:Class ;
  rdfs:label "Dataset or data asset"@en ;
  skos:definition "A collection of data managed as one thing, such as a critical data asset."@en .
dqc:Rule a owl:Class ;
  rdfs:label "Data quality rule"@en ;
  skos:definition "A testable statement of what good data looks like, with a target."@en .
dqc:Check a owl:Class ;
  rdfs:label "Check type"@en ;
  skos:definition "A kind of test the toolkit can run, such as not_null or freshness."@en .
dqc:Dimension a owl:Class ;
  rdfs:label "Quality dimension"@en ;
  skos:definition "An aspect of quality, such as completeness or timeliness."@en .
dqc:IssueType a owl:Class ;
  rdfs:label "Issue type"@en ;
  skos:definition "A category of data quality problem from the cross-government vocabulary."@en .
dqc:Measurement a owl:Class ;
  rdfs:label "Quality measurement"@en ;
  skos:definition "The result of running a rule on a dataset on a date."@en .
dqc:Issue a owl:Class ;
  rdfs:label "Data quality issue"@en ;
  skos:definition "A rule below target, with a priority and a time to fix."@en .
dqc:Framework a owl:Class ;
  rdfs:label "Framework, standard or policy"@en ;
  skos:definition "A published source of data quality requirements."@en .
dqc:Pack a owl:Class ;
  rdfs:label "Framework pack"@en ;
  skos:definition "Requirements from a framework, tested automatically against results."@en .
dqc:Requirement a owl:Class ;
  rdfs:label "Requirement"@en ;
  skos:definition "One thing a pack or policy asks for, with the evidence that shows it."@en .
dqc:PolicyClause a owl:Class ;
  rdfs:label "Policy clause"@en ;
  skos:definition "One clause of a policy, broken down line by line."@en .
dqc:MetadataConcept a owl:Class ;
  rdfs:label "Metadata concept"@en ;
  skos:definition "A cataloguing concept mapped across standards in the Metadata Rosetta."@en .
dqc:MetadataStandard a owl:Class ;
  rdfs:label "Metadata standard"@en ;
  skos:definition "A standard for describing data, such as DCAT or schema.org."@en .
dqc:Role a owl:Class ;
  rdfs:label "Role"@en ;
  skos:definition "A job role with responsibilities for data quality."@en .
dqc:Skill a owl:Class ;
  rdfs:label "Skill"@en ;
  skos:definition "A data quality skill, aligned with the DDaT capability framework."@en .
dqc:Module a owl:Class ;
  rdfs:label "Learning module"@en ;
  skos:definition "A Commons learning module."@en .
dqc:Course a owl:Class ;
  rdfs:label "Course or qualification"@en ;
  skos:definition "External or Commons training."@en .
dqc:Event a owl:Class ;
  rdfs:label "Event"@en ;
  skos:definition "A conference, workshop, course run or forum about data quality."@en .
dqc:Jurisdiction a owl:Class ;
  rdfs:label "Jurisdiction"@en ;
  skos:definition "A nation, Crown Dependency, Overseas Territory or international level."@en .
dqc:Organisation a owl:Class ;
  rdfs:label "Organisation or network"@en ;
  skos:definition "A body, network or partner."@en .
dqc:Term a owl:Class ;
  rdfs:label "Glossary term"@en ;
  skos:definition "A term defined in the Commons glossary."@en .
dqc:Stage a owl:Class ;
  rdfs:label "Lineage stage"@en ;
  skos:definition "A step data passes through, from source to report."@en .
dqc:Capability a owl:Class ;
  rdfs:label "Capability"@en ;
  skos:definition "A part of end-to-end data quality management, from the Commons capability model."@en .
dqc:Workflow a owl:Class ;
  rdfs:label "Workflow"@en ;
  skos:definition "A process that carries out a capability, with steps, roles and records (BPMN in models/out/bpmn)."@en .
dqc:RecordType a owl:Class ;
  rdfs:label "Record type"@en ;
  skos:definition "A kind of record the data quality capability keeps, from the Commons information model."@en .
dqc:Thing a owl:Class ;
  rdfs:label "Any thing"@en ;
  skos:definition "Any node in the graph (used as a range when a relationship can point to several classes)."@en .
dqc:guidedBy a owl:ObjectProperty ;
  rdfs:label "guided by"@en ;
  skos:definition "The policy or guidance a capability or record type puts into practice."@en ;
  rdfs:domain dqc:Thing ;
  rdfs:range dqc:Framework .
dqc:keepsRecord a owl:ObjectProperty ;
  rdfs:label "keeps record"@en ;
  skos:definition "A record type a capability manages."@en ;
  rdfs:domain dqc:Capability ;
  rdfs:range dqc:RecordType .
dqc:realisedBy a owl:ObjectProperty ;
  rdfs:label "realised by"@en ;
  skos:definition "A workflow that carries out a capability."@en ;
  rdfs:domain dqc:Capability ;
  rdfs:range dqc:Workflow .
dqc:performedBy a owl:ObjectProperty ;
  rdfs:label "performed by"@en ;
  skos:definition "A role with steps in a workflow."@en ;
  rdfs:domain dqc:Workflow ;
  rdfs:range dqc:Role .
dqc:createsRecord a owl:ObjectProperty ;
  rdfs:label "creates record"@en ;
  skos:definition "A record type a workflow creates or updates."@en ;
  rdfs:domain dqc:Workflow ;
  rdfs:range dqc:RecordType .
dqc:linksTo a owl:ObjectProperty ;
  rdfs:label "links to"@en ;
  skos:definition "One record type refers to another."@en ;
  rdfs:domain dqc:RecordType ;
  rdfs:range dqc:RecordType .
dqc:measures a owl:ObjectProperty ;
  rdfs:label "measures"@en ;
  skos:definition "The dimension a rule measures."@en ;
  rdfs:domain dqc:Rule ;
  rdfs:range dqc:Dimension .
dqc:uses a owl:ObjectProperty ;
  rdfs:label "uses check"@en ;
  skos:definition "The check type a rule runs."@en ;
  rdfs:domain dqc:Rule ;
  rdfs:range dqc:Check .
dqc:checksDimension a owl:ObjectProperty ;
  rdfs:label "checks dimension"@en ;
  skos:definition "The dimension a check type usually measures."@en ;
  rdfs:domain dqc:Check ;
  rdfs:range dqc:Dimension .
dqc:classifiedAs a owl:ObjectProperty ;
  rdfs:label "classified as"@en ;
  skos:definition "The issue type of an issue."@en ;
  rdfs:domain dqc:Issue ;
  rdfs:range dqc:IssueType .
dqc:inDimension a owl:ObjectProperty ;
  rdfs:label "in dimension"@en ;
  skos:definition "The dimension an issue type belongs to."@en ;
  rdfs:domain dqc:IssueType ;
  rdfs:range dqc:Dimension .
dqc:mapsTo a owl:ObjectProperty ;
  rdfs:label "maps to"@en ;
  skos:definition "A framework dimension maps to a Commons dimension."@en ;
  rdfs:domain dqc:Framework ;
  rdfs:range dqc:Dimension .
dqc:implements a owl:ObjectProperty ;
  rdfs:label "implements"@en ;
  skos:definition "The framework a pack puts into practice."@en ;
  rdfs:domain dqc:Pack ;
  rdfs:range dqc:Framework .
dqc:requires a owl:ObjectProperty ;
  rdfs:label "requires"@en ;
  skos:definition "A requirement in a pack."@en ;
  rdfs:domain dqc:Pack ;
  rdfs:range dqc:Requirement .
dqc:evidencedBy a owl:ObjectProperty ;
  rdfs:label "evidenced by"@en ;
  skos:definition "Evidence that shows a requirement is met (a check or a dimension)."@en ;
  rdfs:domain dqc:Requirement ;
  rdfs:range dqc:Check .
dqc:clauseOf a owl:ObjectProperty ;
  rdfs:label "clause of"@en ;
  skos:definition "The policy a clause belongs to."@en ;
  rdfs:domain dqc:PolicyClause ;
  rdfs:range dqc:Framework .
dqc:supportedBy a owl:ObjectProperty ;
  rdfs:label "supported by"@en ;
  skos:definition "How the toolkit supports a clause."@en ;
  rdfs:domain dqc:PolicyClause ;
  rdfs:range dqc:Check .
dqc:appliesIn a owl:ObjectProperty ;
  rdfs:label "applies in"@en ;
  skos:definition "Where a framework applies."@en ;
  rdfs:domain dqc:Framework ;
  rdfs:range dqc:Jurisdiction .
dqc:expressedIn a owl:ObjectProperty ;
  rdfs:label "expressed in"@en ;
  skos:definition "A standard's term for a metadata concept."@en ;
  rdfs:domain dqc:MetadataConcept ;
  rdfs:range dqc:MetadataStandard .
dqc:needsSkill a owl:ObjectProperty ;
  rdfs:label "needs skill"@en ;
  skos:definition "A skill a role needs."@en ;
  rdfs:domain dqc:Role ;
  rdfs:range dqc:Skill .
dqc:teaches a owl:ObjectProperty ;
  rdfs:label "teaches"@en ;
  skos:definition "A skill a course or module teaches."@en ;
  rdfs:domain dqc:Course ;
  rdfs:range dqc:Skill .
dqc:forRole a owl:ObjectProperty ;
  rdfs:label "for role"@en ;
  skos:definition "A module on a role's pathway."@en ;
  rdfs:domain dqc:Module ;
  rdfs:range dqc:Role .
dqc:about a owl:ObjectProperty ;
  rdfs:label "about"@en ;
  skos:definition "A glossary term this node is about (for example an event topic, or an open standard about metadata)."@en ;
  rdfs:domain dqc:Thing ;
  rdfs:range dqc:Term .
dqc:partOf a owl:ObjectProperty ;
  rdfs:label "part of"@en ;
  skos:definition "A place within a wider grouping."@en ;
  rdfs:domain dqc:Jurisdiction ;
  rdfs:range dqc:Jurisdiction .
dqc:flowsTo a owl:ObjectProperty ;
  rdfs:label "flows to"@en ;
  skos:definition "Data lineage: the next stage."@en ;
  rdfs:domain dqc:Stage ;
  rdfs:range dqc:Stage .
dqc:broader a owl:ObjectProperty ;
  rdfs:label "broader"@en ;
  skos:definition "A broader term (SKOS broader)."@en ;
  rdfs:domain dqc:Term ;
  rdfs:range dqc:Term .
dqc:related a owl:ObjectProperty ;
  rdfs:label "related"@en ;
  skos:definition "A related term (SKOS related)."@en ;
  rdfs:domain dqc:Term ;
  rdfs:range dqc:Term .
dqc:definedBy a owl:ObjectProperty ;
  rdfs:label "defined by"@en ;
  skos:definition "The source of a term's definition."@en ;
  rdfs:domain dqc:Term ;
  rdfs:range dqc:Framework .
dqc:defaultIssue a owl:ObjectProperty ;
  rdfs:label "default issue"@en ;
  skos:definition "The issue type a failing check raises by default."@en ;
  rdfs:domain dqc:Check ;
  rdfs:range dqc:IssueType .
dqc:heldIn a owl:ObjectProperty ;
  rdfs:label "held in"@en ;
  skos:definition "Where an event takes place."@en ;
  rdfs:domain dqc:Event ;
  rdfs:range dqc:Jurisdiction .
dqc:sameAs a owl:ObjectProperty ;
  rdfs:label "same as"@en ;
  skos:definition "The glossary term names the same thing as another node (a dimension, role or standard)."@en ;
  rdfs:domain dqc:Term ;
  rdfs:range dqc:Thing .
dqc:involves a owl:ObjectProperty ;
  rdfs:label "involves"@en ;
  skos:definition "A concept, standard or tool used at a lineage stage."@en ;
  rdfs:domain dqc:Stage ;
  rdfs:range dqc:Thing .
dqc:inScope a owl:ObjectProperty ;
  rdfs:label "in scope of"@en ;
  skos:definition "A place or level the Commons serves."@en ;
  rdfs:domain dqc:Jurisdiction ;
  rdfs:range dqc:Jurisdiction .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/completeness> a dqc:Dimension, skos:Concept ;
  rdfs:label "Completeness"@en ;
  skos:definition "The proportion of stored data against the potential of being 100% complete."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#completeness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/uniqueness> a dqc:Dimension, skos:Concept ;
  rdfs:label "Uniqueness"@en ;
  skos:definition "Nothing will be recorded more than once based upon how that thing is identified."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#uniqueness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/consistency> a dqc:Dimension, skos:Concept ;
  rdfs:label "Consistency"@en ;
  skos:definition "The absence of difference when comparing two or more representations of a thing against a definition."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#consistency> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/timeliness> a dqc:Dimension, skos:Concept ;
  rdfs:label "Timeliness"@en ;
  skos:definition "The degree to which data represent reality from the required point in time."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#timeliness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/validity> a dqc:Dimension, skos:Concept ;
  rdfs:label "Validity"@en ;
  skos:definition "Data are valid if they conform to the syntax (format, type, range) of their definition."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#validity> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy> a dqc:Dimension, skos:Concept ;
  rdfs:label "Accuracy"@en ;
  skos:definition "The degree to which data correctly describe the real-world object or event being described."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#accuracy> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/representativeness> a dqc:Dimension, skos:Concept ;
  rdfs:label "Representativeness"@en ;
  skos:definition "The degree to which data cover, and are equally good for, every group of people they describe. Extension proposed by this project; not one of the six DAMA UK dimensions."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#representativeness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/metadata> a dqc:Dimension, skos:Concept ;
  rdfs:label "Metadata quality"@en ;
  skos:definition "The degree to which an asset is described well enough to find, understand, trust and reuse it. Covers GOV.UK critical data asset metadata and DAM policy duties."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#metadata> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/relevance> a dqc:Dimension, skos:Concept ;
  rdfs:label "Relevance"@en ;
  skos:definition "Whether the data meets the needs of users. ESS 'plus' dimension, assessed mainly by qualitative evidence."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#relevance> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/coherence-comparability> a dqc:Dimension, skos:Concept ;
  rdfs:label "Coherence and comparability"@en ;
  skos:definition "Whether the data is coherent with other sources and comparable over time and between areas. ESS 'plus' dimension."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#coherence-comparability> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accessibility-clarity> a dqc:Dimension, skos:Concept ;
  rdfs:label "Accessibility and clarity"@en ;
  skos:definition "Whether the data is clear, released in a convenient form, and has supporting metadata and guidance. ESS 'plus' dimension."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#accessibility-clarity> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/IssueType/missing-value> a dqc:IssueType, skos:Concept ;
  rdfs:label "Missing value"@en ;
  skos:definition "A required field is blank for a record."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#issue/missing-value> ;
  dqc:inDimension <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/completeness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/IssueType/missing-field> a dqc:IssueType, skos:Concept ;
  rdfs:label "Missing field"@en ;
  skos:definition "A required field is absent from the file."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#issue/missing-field> ;
  dqc:inDimension <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/completeness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/IssueType/unexplained-gap> a dqc:IssueType, skos:Concept ;
  rdfs:label "Unexplained gap in a series"@en ;
  skos:definition "A time or area series has a missing period or area with no explanation."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#issue/unexplained-gap> ;
  dqc:inDimension <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/completeness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/IssueType/duplicate-record> a dqc:IssueType, skos:Concept ;
  rdfs:label "Duplicate record"@en ;
  skos:definition "The same thing is recorded more than once."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#issue/duplicate-record> ;
  dqc:inDimension <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/uniqueness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/IssueType/duplicate-reference> a dqc:IssueType, skos:Concept ;
  rdfs:label "Reference not unique"@en ;
  skos:definition "Two or more records share an identifier that should be unique."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#issue/duplicate-reference> ;
  dqc:inDimension <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/uniqueness> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/IssueType/invalid-type> a dqc:IssueType, skos:Concept ;
  rdfs:label "Invalid data type"@en ;
  skos:definition "A value cannot be read as its declared type (number, date, flag, URI)."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#issue/invalid-type> ;
  dqc:inDimension <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/validity> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/IssueType/pattern-mismatch> a dqc:IssueType, skos:Concept ;
  rdfs:label "Value does not match pattern"@en ;
  skos:definition "A value does not follow its required format, for example a code pattern."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#issue/pattern-mismatch> ;
  dqc:inDimension <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/validity> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/IssueType/invalid-category> a dqc:IssueType, skos:Concept ;
  rdfs:label "Invalid category value"@en ;
  skos:definition "A value is not in the agreed list of allowed values."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#issue/invalid-category> ;
  dqc:inDimension <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/validity> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/IssueType/invalid-geometry> a dqc:IssueType, skos:Concept ;
  rdfs:label "Invalid geometry"@en ;
  skos:definition "A shape or coordinate cannot be processed."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#issue/invalid-geometry> ;
  dqc:inDimension <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/validity> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/IssueType/out-of-range> a dqc:IssueType, skos:Concept ;
  rdfs:label "Value out of range"@en ;
  skos:definition "A number is smaller or larger than its allowed range."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#issue/out-of-range> ;
  dqc:inDimension <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/IssueType/implausible-value> a dqc:IssueType, skos:Concept ;
  rdfs:label "Implausible value"@en ;
  skos:definition "A number is allowed but so far from the rest that it needs checking (an outlier)."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#issue/implausible-value> ;
  dqc:inDimension <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/IssueType/future-date> a dqc:IssueType, skos:Concept ;
  rdfs:label "Date in the future"@en ;
  skos:definition "A date that cannot be in the future is in the future."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#issue/future-date> ;
  dqc:inDimension <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/IssueType/implausible-date> a dqc:IssueType, skos:Concept ;
  rdfs:label "Implausible date"@en ;
  skos:definition "A date is too far in the past or future to be credible."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#issue/implausible-date> ;
  dqc:inDimension <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/IssueType/out-of-bounds> a dqc:IssueType, skos:Concept ;
  rdfs:label "Location out of bounds"@en ;
  skos:definition "Coordinates fall outside the expected area."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#issue/out-of-bounds> ;
  dqc:inDimension <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/accuracy> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/IssueType/cross-field-inconsistency> a dqc:IssueType, skos:Concept ;
  rdfs:label "Fields disagree"@en ;
  skos:definition "Two fields in the same record contradict each other."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#issue/cross-field-inconsistency> ;
  dqc:inDimension <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/consistency> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/IssueType/totals-mismatch> a dqc:IssueType, skos:Concept ;
  rdfs:label "Parts do not add up"@en ;
  skos:definition "Parts do not sum to the stated total, or shares exceed 100%."@en ;
  owl:sameAs <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#issue/totals-mismatch> ;
  dqc:inDimension <https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/Dimension/consistency> .
<https://cyberdudeuk.github.io/ndl-dq-assurance/vocab#k/IssueType/reference-mismatch> a dqc:IssueType, skos:Concept ;
  rdfs:label "Reference not found"@en ;
