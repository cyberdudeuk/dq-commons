<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_P1" targetNamespace="https://cyberdudeuk.github.io/dq-commons/model#" exporter="dq-commons build_models.py" exporterVersion="1.1.0">
  <bpmn:collaboration id="Collab_P1">
    <bpmn:participant id="Part_P1" name="P1 Identify and register critical data assets" processRef="Process_P1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_P1" name="Identify and register critical data assets" isExecutable="false">
    <bpmn:documentation>Realises capability C2. Generated from models/dq-capability.yaml; guidance codes are explained in models/README.md.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P1">
      <bpmn:lane id="Lane_P1_0" name="Chief data officer">
        <bpmn:flowNodeRef>P1_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_a</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P1_1" name="Data owner">
        <bpmn:flowNodeRef>P1_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_x</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P1_2" name="Data steward">
        <bpmn:flowNodeRef>P1_b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P1_3" name="Catalogue and GDS">
        <bpmn:flowNodeRef>P1_h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_z</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P1_s" name="Annual exercise or new data shared">
      <bpmn:outgoing>Flow_P1_s_a</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P1_a" name="Lead the exercise and nominate a coordinator">
      <bpmn:documentation>Guidance: IDC.</bpmn:documentation>
      <bpmn:incoming>Flow_P1_s_a</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_a_b</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P1_b" name="List data provided to or acquired from other organisations">
      <bpmn:documentation>Guidance: IDC.</bpmn:documentation>
      <bpmn:incoming>Flow_P1_a_b</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_b_g</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_P1_b_DataSharingAgreement"><bpmn:targetRef>DOR_P1_b_DataSharingAgreement</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P1_g" name="Serves one of the 7 purposes?">
      <bpmn:incoming>Flow_P1_b_g</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_g_c</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_g_x</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P1_x" name="Not designated; record the reason">
      <bpmn:incoming>Flow_P1_g_x</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P1_c" name="Designate the asset and name the data owner">
      <bpmn:documentation>Guidance: DAM, DOM, IDC. In the Commons: baseline.html.</bpmn:documentation>
      <bpmn:incoming>Flow_P1_g_c</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_c_d</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_P1_c_DataAsset"><bpmn:targetRef>DOR_P1_c_DataAsset</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOut_P1_c_RoleAssignment"><bpmn:targetRef>DOR_P1_c_RoleAssignment</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="P1_d" name="Record the metadata (13 properties)">
      <bpmn:documentation>Guidance: MD. In the Commons: weaver.html.</bpmn:documentation>
      <bpmn:incoming>Flow_P1_c_d</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_d_e</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_P1_d_MetadataRecord"><bpmn:targetRef>DOR_P1_d_MetadataRecord</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOut_P1_d_Distribution"><bpmn:targetRef>DOR_P1_d_Distribution</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="P1_e" name="Check the metadata against the UK profile">
      <bpmn:documentation>Guidance: MD. In the Commons: weaver.html.</bpmn:documentation>
      <bpmn:incoming>Flow_P1_d_e</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_e_f</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DataIn_P1_e_MetadataRecord"><bpmn:sourceRef>DOR_P1_e_MetadataRecord</bpmn:sourceRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="P1_f" name="Start or confirm the DQAP">
      <bpmn:documentation>Guidance: DAM, DQAP1. In the Commons: playbook.html. Playbook stage: identify.</bpmn:documentation>
      <bpmn:incoming>Flow_P1_e_f</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_f_h</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_P1_f_DataQualityActionPlan"><bpmn:targetRef>DOR_P1_f_DataQualityActionPlan</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="P1_h" name="Register in the catalogue and report to GDS">
      <bpmn:documentation>Guidance: DAM, IDC. In the Commons: baseline.html.</bpmn:documentation>
      <bpmn:incoming>Flow_P1_f_h</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_h_z</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_P1_h_AssetReturn"><bpmn:targetRef>DOR_P1_h_AssetReturn</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P1_z" name="Asset registered">
      <bpmn:incoming>Flow_P1_h_z</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P1_s_a" sourceRef="P1_s" targetRef="P1_a"/>
    <bpmn:sequenceFlow id="Flow_P1_a_b" sourceRef="P1_a" targetRef="P1_b"/>
    <bpmn:sequenceFlow id="Flow_P1_b_g" sourceRef="P1_b" targetRef="P1_g"/>
    <bpmn:sequenceFlow id="Flow_P1_g_c" sourceRef="P1_g" targetRef="P1_c" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_P1_g_x" sourceRef="P1_g" targetRef="P1_x" name="No"/>
    <bpmn:sequenceFlow id="Flow_P1_c_d" sourceRef="P1_c" targetRef="P1_d"/>
    <bpmn:sequenceFlow id="Flow_P1_d_e" sourceRef="P1_d" targetRef="P1_e"/>
    <bpmn:sequenceFlow id="Flow_P1_e_f" sourceRef="P1_e" targetRef="P1_f"/>
    <bpmn:sequenceFlow id="Flow_P1_f_h" sourceRef="P1_f" targetRef="P1_h"/>
    <bpmn:sequenceFlow id="Flow_P1_h_z" sourceRef="P1_h" targetRef="P1_z"/>
    <bpmn:dataObject id="DO_P1_AssetReturn" name="AssetReturn"/>
    <bpmn:dataObject id="DO_P1_DataAsset" name="DataAsset"/>
    <bpmn:dataObject id="DO_P1_DataQualityActionPlan" name="DataQualityActionPlan"/>
    <bpmn:dataObject id="DO_P1_DataSharingAgreement" name="DataSharingAgreement"/>
    <bpmn:dataObject id="DO_P1_Distribution" name="Distribution"/>
    <bpmn:dataObject id="DO_P1_MetadataRecord" name="MetadataRecord"/>
    <bpmn:dataObject id="DO_P1_RoleAssignment" name="RoleAssignment"/>
    <bpmn:dataObjectReference id="DOR_P1_b_DataSharingAgreement" name="DataSharingAgreement" dataObjectRef="DO_P1_DataSharingAgreement"/>
    <bpmn:dataObjectReference id="DOR_P1_c_DataAsset" name="DataAsset" dataObjectRef="DO_P1_DataAsset"/>
    <bpmn:dataObjectReference id="DOR_P1_c_RoleAssignment" name="RoleAssignment" dataObjectRef="DO_P1_RoleAssignment"/>
    <bpmn:dataObjectReference id="DOR_P1_d_MetadataRecord" name="MetadataRecord" dataObjectRef="DO_P1_MetadataRecord"/>
    <bpmn:dataObjectReference id="DOR_P1_d_Distribution" name="Distribution" dataObjectRef="DO_P1_Distribution"/>
    <bpmn:dataObjectReference id="DOR_P1_e_MetadataRecord" name="MetadataRecord" dataObjectRef="DO_P1_MetadataRecord"/>
    <bpmn:dataObjectReference id="DOR_P1_f_DataQualityActionPlan" name="DataQualityActionPlan" dataObjectRef="DO_P1_DataQualityActionPlan"/>
    <bpmn:dataObjectReference id="DOR_P1_h_AssetReturn" name="AssetReturn" dataObjectRef="DO_P1_AssetReturn"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P1"><bpmndi:BPMNPlane id="Plane_P1" bpmnElement="Collab_P1">
    <bpmndi:BPMNShape id="Part_P1_di" bpmnElement="Part_P1" isHorizontal="true"><dc:Bounds x="0" y="0" width="2140" height="700"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_P1_0_di" bpmnElement="Lane_P1_0" isHorizontal="true"><dc:Bounds x="30" y="0" width="2110" height="175"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_P1_1_di" bpmnElement="Lane_P1_1" isHorizontal="true"><dc:Bounds x="30" y="175" width="2110" height="175"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_P1_2_di" bpmnElement="Lane_P1_2" isHorizontal="true"><dc:Bounds x="30" y="350" width="2110" height="175"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_P1_3_di" bpmnElement="Lane_P1_3" isHorizontal="true"><dc:Bounds x="30" y="525" width="2110" height="175"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P1_s_di" bpmnElement="P1_s"><dc:Bounds x="199" y="54" width="42" height="42"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P1_a_di" bpmnElement="P1_a"><dc:Bounds x="328" y="34" width="145" height="82"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P1_b_di" bpmnElement="P1_b"><dc:Bounds x="508" y="384" width="145" height="82"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P1_g_di" bpmnElement="P1_g" isMarkerVisible="true"><dc:Bounds x="729" y="219" width="62" height="62"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P1_x_di" bpmnElement="P1_x"><dc:Bounds x="919" y="229" width="42" height="42"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P1_c_di" bpmnElement="P1_c"><dc:Bounds x="1048" y="209" width="145" height="82"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P1_d_di" bpmnElement="P1_d"><dc:Bounds x="1228" y="384" width="145" height="82"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P1_e_di" bpmnElement="P1_e"><dc:Bounds x="1408" y="384" width="145" height="82"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P1_f_di" bpmnElement="P1_f"><dc:Bounds x="1588" y="209" width="145" height="82"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P1_h_di" bpmnElement="P1_h"><dc:Bounds x="1767" y="559" width="145" height="82"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P1_z_di" bpmnElement="P1_z"><dc:Bounds x="1999" y="579" width="42" height="42"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="DOR_P1_b_DataSharingAgreement_di" bpmnElement="DOR_P1_b_DataSharingAgreement"><dc:Bounds x="508" y="484" width="28" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="DataOut_P1_b_DataSharingAgreement_di" bpmnElement="DataOut_P1_b_DataSharingAgreement"><di:waypoint x="522" y="466"/><di:waypoint x="522" y="484"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNShape id="DOR_P1_c_DataAsset_di" bpmnElement="DOR_P1_c_DataAsset"><dc:Bounds x="1048" y="309" width="28" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="DataOut_P1_c_DataAsset_di" bpmnElement="DataOut_P1_c_DataAsset"><di:waypoint x="1062" y="291"/><di:waypoint x="1062" y="309"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNShape id="DOR_P1_c_RoleAssignment_di" bpmnElement="DOR_P1_c_RoleAssignment"><dc:Bounds x="1082" y="309" width="28" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="DataOut_P1_c_RoleAssignment_di" bpmnElement="DataOut_P1_c_RoleAssignment"><di:waypoint x="1096" y="291"/><di:waypoint x="1096" y="309"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNShape id="DOR_P1_d_MetadataRecord_di" bpmnElement="DOR_P1_d_MetadataRecord"><dc:Bounds x="1228" y="484" width="28" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="DataOut_P1_d_MetadataRecord_di" bpmnElement="DataOut_P1_d_MetadataRecord"><di:waypoint x="1242" y="466"/><di:waypoint x="1242" y="484"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNShape id="DOR_P1_d_Distribution_di" bpmnElement="DOR_P1_d_Distribution"><dc:Bounds x="1262" y="484" width="28" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="DataOut_P1_d_Distribution_di" bpmnElement="DataOut_P1_d_Distribution"><di:waypoint x="1276" y="466"/><di:waypoint x="1276" y="484"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNShape id="DOR_P1_e_MetadataRecord_di" bpmnElement="DOR_P1_e_MetadataRecord"><dc:Bounds x="1408" y="484" width="28" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="DataIn_P1_e_MetadataRecord_di" bpmnElement="DataIn_P1_e_MetadataRecord"><di:waypoint x="1422" y="466"/><di:waypoint x="1422" y="484"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNShape id="DOR_P1_f_DataQualityActionPlan_di" bpmnElement="DOR_P1_f_DataQualityActionPlan"><dc:Bounds x="1588" y="309" width="28" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="DataOut_P1_f_DataQualityActionPlan_di" bpmnElement="DataOut_P1_f_DataQualityActionPlan"><di:waypoint x="1602" y="291"/><di:waypoint x="1602" y="309"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNShape id="DOR_P1_h_AssetReturn_di" bpmnElement="DOR_P1_h_AssetReturn"><dc:Bounds x="1767" y="659" width="28" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="DataOut_P1_h_AssetReturn_di" bpmnElement="DataOut_P1_h_AssetReturn"><di:waypoint x="1781" y="641"/><di:waypoint x="1781" y="659"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_P1_s_a_di" bpmnElement="Flow_P1_s_a"><di:waypoint x="241" y="75"/><di:waypoint x="328" y="75"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_P1_a_b_di" bpmnElement="Flow_P1_a_b"><di:waypoint x="472" y="75"/><di:waypoint x="488" y="75"/><di:waypoint x="488" y="425"/><di:waypoint x="508" y="425"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_P1_b_g_di" bpmnElement="Flow_P1_b_g"><di:waypoint x="652" y="425"/><di:waypoint x="709" y="425"/><di:waypoint x="709" y="250"/><di:waypoint x="729" y="250"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_P1_g_c_di" bpmnElement="Flow_P1_g_c"><di:waypoint x="791" y="250"/><di:waypoint x="1048" y="250"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_P1_g_x_di" bpmnElement="Flow_P1_g_x"><di:waypoint x="791" y="250"/><di:waypoint x="919" y="250"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_P1_c_d_di" bpmnElement="Flow_P1_c_d"><di:waypoint x="1192" y="250"/><di:waypoint x="1208" y="250"/><di:waypoint x="1208" y="425"/><di:waypoint x="1228" y="425"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_P1_d_e_di" bpmnElement="Flow_P1_d_e"><di:waypoint x="1373" y="425"/><di:waypoint x="1408" y="425"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_P1_e_f_di" bpmnElement="Flow_P1_e_f"><di:waypoint x="1552" y="425"/><di:waypoint x="1568" y="425"/><di:waypoint x="1568" y="250"/><di:waypoint x="1588" y="250"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_P1_f_h_di" bpmnElement="Flow_P1_f_h"><di:waypoint x="1733" y="250"/><di:waypoint x="1747" y="250"/><di:waypoint x="1747" y="600"/><di:waypoint x="1767" y="600"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_P1_h_z_di" bpmnElement="Flow_P1_h_z"><di:waypoint x="1912" y="600"/><di:waypoint x="1999" y="600"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
