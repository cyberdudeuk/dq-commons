<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_P2" targetNamespace="https://cyberdudeuk.github.io/dq-commons/model#" exporter="dq-commons build_models.py" exporterVersion="1.0.0">
  <bpmn:collaboration id="Collab_P2">
    <bpmn:participant id="Part_P2" name="P2 Data quality action plan lifecycle (7 steps)" processRef="Process_P2"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_P2" name="Data quality action plan lifecycle (7 steps)" isExecutable="false">
    <bpmn:documentation>Realises capability C5. Generated from models/dq-capability.yaml; guidance codes are explained in models/README.md.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P2">
      <bpmn:lane id="Lane_P2_0" name="Data owner">
        <bpmn:flowNodeRef>P2_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_s4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_s6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_g</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P2_1" name="Data steward">
        <bpmn:flowNodeRef>P2_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_s5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P2_2" name="Data custodian">
        <bpmn:flowNodeRef>P2_s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_s7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_z</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P2_3" name="Data users">
        <bpmn:flowNodeRef>P2_u</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P2_s" name="Critical data asset designated">
      <bpmn:outgoing>Flow_P2_s_s1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P2_s1" name="1. Identify critical data and known issues">
      <bpmn:documentation>Guidance: DQAP1</bpmn:documentation>
      <bpmn:incoming>Flow_P2_s_s1</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_s1_s2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_P2_s1_DataItem"><bpmn:targetRef>DOR_P2_s1_DataItem</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOut_P2_s1_Issue"><bpmn:targetRef>DOR_P2_s1_Issue</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="P2_s2" name="2. Identify users, needs and quality rules">
      <bpmn:documentation>Guidance: DQAP2, GDQF-P2</bpmn:documentation>
      <bpmn:incoming>Flow_P2_s1_s2</bpmn:incoming>
      <bpmn:incoming>Flow_P2_g_s2</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_s2_s3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_P2_s2_UserNeed"><bpmn:targetRef>DOR_P2_s2_UserNeed</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOut_P2_s2_QualityRule"><bpmn:targetRef>DOR_P2_s2_QualityRule</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="P2_s3" name="3. Assess current quality (baseline)">
      <bpmn:documentation>Guidance: DQAP3, GDQF-P3</bpmn:documentation>
      <bpmn:incoming>Flow_P2_s2_s3</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_s3_s4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_P2_s3_MeasurementRun"><bpmn:targetRef>DOR_P2_s3_MeasurementRun</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOut_P2_s3_RuleResult"><bpmn:targetRef>DOR_P2_s3_RuleResult</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOut_P2_s3_Issue"><bpmn:targetRef>DOR_P2_s3_Issue</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="P2_s4" name="4. Prioritise improvements and set goals">
      <bpmn:documentation>Guidance: DQAP4, IF</bpmn:documentation>
      <bpmn:incoming>Flow_P2_s3_s4</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_s4_s5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_P2_s4_RemediationAction"><bpmn:targetRef>DOR_P2_s4_RemediationAction</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="P2_s5" name="5. Find root causes and take action">
      <bpmn:documentation>Guidance: DQAP5, GDQF-P5</bpmn:documentation>
      <bpmn:incoming>Flow_P2_s4_s5</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_s5_s6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_P2_s5_RootCause"><bpmn:targetRef>DOR_P2_s5_RootCause</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOut_P2_s5_RemediationAction"><bpmn:targetRef>DOR_P2_s5_RemediationAction</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="P2_s6" name="6. Report on data quality">
      <bpmn:documentation>Guidance: DQAP6, GDQF-P4</bpmn:documentation>
      <bpmn:incoming>Flow_P2_s5_s6</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_s6_u</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_P2_s6_CommunicationPlanEntry"><bpmn:targetRef>DOR_P2_s6_CommunicationPlanEntry</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOut_P2_s6_QualityStatement"><bpmn:targetRef>DOR_P2_s6_QualityStatement</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="P2_u" name="Use the data with its caveats; report problems">
      <bpmn:documentation>Guidance: DQAP6</bpmn:documentation>
      <bpmn:incoming>Flow_P2_s6_u</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_u_s7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P2_s7" name="7. Repeat measurement over time">
      <bpmn:documentation>Guidance: DQAP7</bpmn:documentation>
      <bpmn:incoming>Flow_P2_u_s7</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_s7_g</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_P2_s7_MeasurementRun"><bpmn:targetRef>DOR_P2_s7_MeasurementRun</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P2_g" name="Significant change to collection or processing?">
      <bpmn:incoming>Flow_P2_s7_g</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_g_s2</bpmn:outgoing>
      <bpmn:outgoing>Flow_P2_g_z</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P2_z" name="Next measurement cycle">
      <bpmn:incoming>Flow_P2_g_z</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P2_s_s1" sourceRef="P2_s" targetRef="P2_s1"/>
    <bpmn:sequenceFlow id="Flow_P2_s1_s2" sourceRef="P2_s1" targetRef="P2_s2"/>
    <bpmn:sequenceFlow id="Flow_P2_s2_s3" sourceRef="P2_s2" targetRef="P2_s3"/>
    <bpmn:sequenceFlow id="Flow_P2_s3_s4" sourceRef="P2_s3" targetRef="P2_s4"/>
    <bpmn:sequenceFlow id="Flow_P2_s4_s5" sourceRef="P2_s4" targetRef="P2_s5"/>
    <bpmn:sequenceFlow id="Flow_P2_s5_s6" sourceRef="P2_s5" targetRef="P2_s6"/>
    <bpmn:sequenceFlow id="Flow_P2_s6_u" sourceRef="P2_s6" targetRef="P2_u"/>
    <bpmn:sequenceFlow id="Flow_P2_u_s7" sourceRef="P2_u" targetRef="P2_s7"/>
    <bpmn:sequenceFlow id="Flow_P2_s7_g" sourceRef="P2_s7" targetRef="P2_g"/>
    <bpmn:sequenceFlow id="Flow_P2_g_s2" sourceRef="P2_g" targetRef="P2_s2" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_P2_g_z" sourceRef="P2_g" targetRef="P2_z" name="No"/>
    <bpmn:dataObject id="DO_P2_CommunicationPlanEntry" name="CommunicationPlanEntry"/>
    <bpmn:dataObject id="DO_P2_DataItem" name="DataItem"/>
    <bpmn:dataObject id="DO_P2_Issue" name="Issue"/>
    <bpmn:dataObject id="DO_P2_MeasurementRun" name="MeasurementRun"/>
    <bpmn:dataObject id="DO_P2_QualityRule" name="QualityRule"/>
    <bpmn:dataObject id="DO_P2_QualityStatement" name="QualityStatement"/>
    <bpmn:dataObject id="DO_P2_RemediationAction" name="RemediationAction"/>
    <bpmn:dataObject id="DO_P2_RootCause" name="RootCause"/>
    <bpmn:dataObject id="DO_P2_RuleResult" name="RuleResult"/>
    <bpmn:dataObject id="DO_P2_UserNeed" name="UserNeed"/>
    <bpmn:dataObjectReference id="DOR_P2_s1_DataItem" name="DataItem" dataObjectRef="DO_P2_DataItem"/>
    <bpmn:dataObjectReference id="DOR_P2_s1_Issue" name="Issue" dataObjectRef="DO_P2_Issue"/>
    <bpmn:dataObjectReference id="DOR_P2_s2_UserNeed" name="UserNeed" dataObjectRef="DO_P2_UserNeed"/>
    <bpmn:dataObjectReference id="DOR_P2_s2_QualityRule" name="QualityRule" dataObjectRef="DO_P2_QualityRule"/>
    <bpmn:dataObjectReference id="DOR_P2_s3_MeasurementRun" name="MeasurementRun" dataObjectRef="DO_P2_MeasurementRun"/>
    <bpmn:dataObjectReference id="DOR_P2_s3_RuleResult" name="RuleResult" dataObjectRef="DO_P2_RuleResult"/>
    <bpmn:dataObjectReference id="DOR_P2_s3_Issue" name="Issue" dataObjectRef="DO_P2_Issue"/>
    <bpmn:dataObjectReference id="DOR_P2_s4_RemediationAction" name="RemediationAction" dataObjectRef="DO_P2_RemediationAction"/>
    <bpmn:dataObjectReference id="DOR_P2_s5_RootCause" name="RootCause" dataObjectRef="DO_P2_RootCause"/>
    <bpmn:dataObjectReference id="DOR_P2_s5_RemediationAction" name="RemediationAction" dataObjectRef="DO_P2_RemediationAction"/>
    <bpmn:dataObjectReference id="DOR_P2_s6_CommunicationPlanEntry" name="CommunicationPlanEntry" dataObjectRef="DO_P2_CommunicationPlanEntry"/>
    <bpmn:dataObjectReference id="DOR_P2_s6_QualityStatement" name="QualityStatement" dataObjectRef="DO_P2_QualityStatement"/>
    <bpmn:dataObjectReference id="DOR_P2_s7_MeasurementRun" name="MeasurementRun" dataObjectRef="DO_P2_MeasurementRun"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P2"><bpmndi:BPMNPlane id="Plane_P2" bpmnElement="Collab_P2">
    <bpmndi:BPMNShape id="Part_P2_di" bpmnElement="Part_P2" isHorizontal="true"><dc:Bounds x="0" y="0" width="2140" height="700"/></bpmndi:BPMNShape>
