  rdfs:label "asset"@en .
dqm:QualityStatement rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:QualityStatement_asset ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:QualityStatement_run a owl:ObjectProperty ; rdfs:domain dqm:QualityStatement ; rdfs:range dqm:MeasurementRun ;
  rdfs:label "run"@en .
