dqm:RemediationAction rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:RemediationAction_review_date ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:RemediationAction_goal_pct a owl:DatatypeProperty ; rdfs:domain dqm:RemediationAction ; rdfs:range xsd:decimal ;
  rdfs:label "goal pct"@en .
dqm:RemediationAction_success_measure a owl:DatatypeProperty ; rdfs:domain dqm:RemediationAction ; rdfs:range xsd:string ;
  rdfs:label "success measure"@en .
dqm:RemediationAction_status a owl:ObjectProperty ; rdfs:domain dqm:RemediationAction ; rdfs:range dqm:ActionStatusValue ;
  rdfs:label "status"@en .
dqm:RemediationAction rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:RemediationAction_status ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

