  rdfs:label "rule"@en .
dqm:RuleResult rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:RuleResult_rule ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:RuleResult_checked a owl:DatatypeProperty ; rdfs:domain dqm:RuleResult ; rdfs:range xsd:integer ;
  rdfs:label "checked"@en .
dqm:RuleResult rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:RuleResult_checked ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:RuleResult_passed a owl:DatatypeProperty ; rdfs:domain dqm:RuleResult ; rdfs:range xsd:integer ;
  rdfs:label "passed"@en .
dqm:RuleResult rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:RuleResult_passed ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:RuleResult_performance_pct a owl:DatatypeProperty ; rdfs:domain dqm:RuleResult ; rdfs:range xsd:decimal ;
  rdfs:label "performance pct"@en .
dqm:RuleResult rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:RuleResult_performance_pct ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
