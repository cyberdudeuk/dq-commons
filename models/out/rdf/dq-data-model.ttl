  rdfs:label "issued on"@en .
dqm:QualityStatement rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:QualityStatement_issued_on ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:QualityStatement_summary a owl:DatatypeProperty ; rdfs:domain dqm:QualityStatement ; rdfs:range xsd:string ;
  rdfs:label "summary"@en .
dqm:QualityStatement rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:QualityStatement_summary ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:QualityStatement_fit_for a owl:DatatypeProperty ; rdfs:domain dqm:QualityStatement ; rdfs:range xsd:string ;
  rdfs:label "fit for"@en .
dqm:QualityStatement_not_fit_for a owl:DatatypeProperty ; rdfs:domain dqm:QualityStatement ; rdfs:range xsd:string ;
  rdfs:label "not fit for"@en .
