dqm:RuleResult rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:RuleResult_meets_target ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:RuleResult_band a owl:ObjectProperty ; rdfs:domain dqm:RuleResult ; rdfs:range dqm:BandValue ;
  rdfs:label "band"@en .
dqm:RuleResult_priority_score a owl:DatatypeProperty ; rdfs:domain dqm:RuleResult ; rdfs:range xsd:integer ;
  rdfs:label "priority score"@en ;
  rdfs:comment "Importance x impact x band score (IF)"@en .

dqm:Issue a owl:Class ;
  rdfs:label "Issue"@en ;
  rdfs:comment "A rule that misses its target, logged in the Data Issues Log."@en ;
  rdfs:seeAlso <https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-action-plan-implementation-guide> ;
  rdfs:seeAlso <https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-issues-framework> ;
  skos:note "Group: Issue management"@en .
dqm:Issue_issue_id a owl:DatatypeProperty ; rdfs:domain dqm:Issue ; rdfs:range xsd:string ;
  rdfs:label "issue id"@en .
dqm:Issue rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:Issue_issue_id ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:Issue_rule a owl:ObjectProperty ; rdfs:domain dqm:Issue ; rdfs:range dqm:QualityRule ;
  rdfs:label "rule"@en .
dqm:Issue rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:Issue_rule ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:Issue_raised_by_result a owl:ObjectProperty ; rdfs:domain dqm:Issue ; rdfs:range dqm:RuleResult ;
  rdfs:label "raised by result"@en .
dqm:Issue_issue_type a owl:DatatypeProperty ; rdfs:domain dqm:Issue ; rdfs:range xsd:string ;
  rdfs:label "issue type"@en ;
  rdfs:comment "From the Commons issue type vocabulary"@en .
dqm:Issue_raised_on a owl:DatatypeProperty ; rdfs:domain dqm:Issue ; rdfs:range xsd:date ;
  rdfs:label "raised on"@en .
dqm:Issue rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:Issue_raised_on ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:Issue_priority a owl:ObjectProperty ; rdfs:domain dqm:Issue ; rdfs:range dqm:PriorityValue ;
  rdfs:label "priority"@en .
dqm:Issue rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:Issue_priority ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:Issue_resolution_timescale a owl:DatatypeProperty ; rdfs:domain dqm:Issue ; rdfs:range xsd:string ;
  rdfs:label "resolution timescale"@en ;
  rdfs:comment "Immediately, or within 1, 3 or 6 measurements (IF)"@en .
dqm:Issue_target_resolution_date a owl:DatatypeProperty ; rdfs:domain dqm:Issue ; rdfs:range xsd:date ;
  rdfs:label "target resolution date"@en .
dqm:Issue_actual_resolution_date a owl:DatatypeProperty ; rdfs:domain dqm:Issue ; rdfs:range xsd:date ;
  rdfs:label "actual resolution date"@en .
dqm:Issue_review_date a owl:DatatypeProperty ; rdfs:domain dqm:Issue ; rdfs:range xsd:date ;
  rdfs:label "review date"@en .
dqm:Issue_status a owl:ObjectProperty ; rdfs:domain dqm:Issue ; rdfs:range dqm:IssueStatusValue ;
  rdfs:label "status"@en .
dqm:Issue rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:Issue_status ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:Issue_cycles_open a owl:DatatypeProperty ; rdfs:domain dqm:Issue ; rdfs:range xsd:integer ;
  rdfs:label "cycles open"@en .
dqm:Issue_recurring a owl:DatatypeProperty ; rdfs:domain dqm:Issue ; rdfs:range xsd:boolean ;
  rdfs:label "recurring"@en .
dqm:Issue_owner a owl:ObjectProperty ; rdfs:domain dqm:Issue ; rdfs:range dqm:RoleAssignment ;
  rdfs:label "owner"@en .

dqm:RootCause a owl:Class ;
  rdfs:label "RootCause"@en ;
  rdfs:comment "The cause of an issue, found by root cause analysis."@en ;
  rdfs:seeAlso <https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-action-plan-implementation-guide> ;
  skos:note "Group: Issue management"@en .
dqm:RootCause_cause_id a owl:DatatypeProperty ; rdfs:domain dqm:RootCause ; rdfs:range xsd:string ;
  rdfs:label "cause id"@en .
dqm:RootCause rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:RootCause_cause_id ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:RootCause_issue a owl:ObjectProperty ; rdfs:domain dqm:RootCause ; rdfs:range dqm:Issue ;
  rdfs:label "issue"@en .
dqm:RootCause rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:RootCause_issue ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:RootCause_description a owl:DatatypeProperty ; rdfs:domain dqm:RootCause ; rdfs:range xsd:string ;
  rdfs:label "description"@en ;
  rdfs:comment "For example from 5 whys"@en .
dqm:RootCause rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:RootCause_description ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:RootCause_systemic a owl:ObjectProperty ; rdfs:domain dqm:RootCause ; rdfs:range dqm:SystemicValue ;
  rdfs:label "systemic"@en .
dqm:RootCause rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:RootCause_systemic ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:RootCause_addressable a owl:DatatypeProperty ; rdfs:domain dqm:RootCause ; rdfs:range xsd:boolean ;
  rdfs:label "addressable"@en ;
  rdfs:comment "Can the organisation fix it itself"@en .
dqm:RootCause_options_considered a owl:DatatypeProperty ; rdfs:domain dqm:RootCause ; rdfs:range xsd:string ;
  rdfs:label "options considered"@en .
dqm:RootCause_cost_benefit a owl:DatatypeProperty ; rdfs:domain dqm:RootCause ; rdfs:range xsd:string ;
  rdfs:label "cost benefit"@en .
dqm:RootCause_lifecycle_stage a owl:ObjectProperty ; rdfs:domain dqm:RootCause ; rdfs:range dqm:LifecycleStageValue ;
  rdfs:label "lifecycle stage"@en .

