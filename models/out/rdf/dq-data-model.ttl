dqm:MaturityAssessment_organisation a owl:ObjectProperty ; rdfs:domain dqm:MaturityAssessment ; rdfs:range dqm:Organisation ;
  rdfs:label "organisation"@en .
dqm:MaturityAssessment rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:MaturityAssessment_organisation ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:MaturityAssessment_assessed_on a owl:DatatypeProperty ; rdfs:domain dqm:MaturityAssessment ; rdfs:range xsd:date ;
  rdfs:label "assessed on"@en .
dqm:MaturityAssessment rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:MaturityAssessment_assessed_on ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:MaturityAssessment_theme a owl:DatatypeProperty ; rdfs:domain dqm:MaturityAssessment ; rdfs:range xsd:string ;
  rdfs:label "theme"@en .
dqm:MaturityAssessment rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:MaturityAssessment_theme ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:MaturityAssessment_level a owl:DatatypeProperty ; rdfs:domain dqm:MaturityAssessment ; rdfs:range xsd:integer ;
  rdfs:label "level"@en ;
  rdfs:comment "1 Beginning to 5 Mastering"@en .
dqm:MaturityAssessment rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:MaturityAssessment_level ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
