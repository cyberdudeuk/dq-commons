dqm:RemediationAction rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:RemediationAction_target_date ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:RemediationAction_review_date a owl:DatatypeProperty ; rdfs:domain dqm:RemediationAction ; rdfs:range xsd:date ;
