  rdfs:label "as of"@en .
dqm:MeasurementRun rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:MeasurementRun_as_of ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:MeasurementRun_rows_checked a owl:DatatypeProperty ; rdfs:domain dqm:MeasurementRun ; rdfs:range xsd:integer ;
  rdfs:label "rows checked"@en .
dqm:MeasurementRun_rules_met a owl:DatatypeProperty ; rdfs:domain dqm:MeasurementRun ; rdfs:range xsd:integer ;
  rdfs:label "rules met"@en .
dqm:MeasurementRun_rules_total a owl:DatatypeProperty ; rdfs:domain dqm:MeasurementRun ; rdfs:range xsd:integer ;
  rdfs:label "rules total"@en .
dqm:MeasurementRun_trust_level a owl:ObjectProperty ; rdfs:domain dqm:MeasurementRun ; rdfs:range dqm:TrustLevelValue ;
  rdfs:label "trust level"@en .
dqm:MeasurementRun_is_baseline a owl:DatatypeProperty ; rdfs:domain dqm:MeasurementRun ; rdfs:range xsd:boolean ;
  rdfs:label "is baseline"@en .

dqm:RuleResult a owl:Class ;
  rdfs:label "RuleResult"@en ;
  rdfs:comment "The result of one rule in one run."@en ;
  rdfs:seeAlso <https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-action-plan-implementation-guide> ;
  rdfs:seeAlso <https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-issues-framework> ;
  skos:note "Group: Measurement"@en .
dqm:RuleResult_result_id a owl:DatatypeProperty ; rdfs:domain dqm:RuleResult ; rdfs:range xsd:string ;
