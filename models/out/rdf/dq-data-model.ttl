dqm:QualityStatement a owl:Class ;
  rdfs:label "QualityStatement"@en ;
  rdfs:comment "A plain English statement of an asset's quality, strengths and limitations."@en ;
  rdfs:seeAlso <https://osr.statisticsauthority.gov.uk/publications/the-code-of-practice-for-statistics/> ;
  rdfs:seeAlso <https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-action-plan-implementation-guide> ;
  skos:note "Group: Reporting"@en .
dqm:QualityStatement_statement_id a owl:DatatypeProperty ; rdfs:domain dqm:QualityStatement ; rdfs:range xsd:string ;
  rdfs:label "statement id"@en .
dqm:QualityStatement rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:QualityStatement_statement_id ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
