dqm:RemediationAction rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:RemediationAction_action_type ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:RemediationAction_description a owl:DatatypeProperty ; rdfs:domain dqm:RemediationAction ; rdfs:range xsd:string ;
  rdfs:label "description"@en .
dqm:RemediationAction rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:RemediationAction_description ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:RemediationAction_owner a owl:ObjectProperty ; rdfs:domain dqm:RemediationAction ; rdfs:range dqm:RoleAssignment ;
  rdfs:label "owner"@en .
dqm:RemediationAction rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dqm:RemediationAction_owner ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
dqm:RemediationAction_target_date a owl:DatatypeProperty ; rdfs:domain dqm:RemediationAction ; rdfs:range xsd:date ;
